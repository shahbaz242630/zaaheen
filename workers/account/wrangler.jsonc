// The account Worker (SIGNIN-DESIGN.md §5). Every account-specific value
// (keys, secrets, Clerk and Paddle ids) is a Cloudflare secret, or
// `.dev.vars` locally (gitignored), never this file (§8.30): see
// `src/config.ts` for the names. TRIAL_KEY (ACCOUNT-DELETION-DESIGN D8) is
// one of them: 32 random bytes as text, made offline, one per deployment,
// never rotated (a new key forgets every earlier trial).
//
// Two deployments, never sharing a secret or a signing key:
//   --env sandbox   api-sandbox.zaaheen.com: Paddle sandbox + Clerk development.
//   (top level)     production, api.zaaheen.com (route and TRIALS added in
//                   S6, session 76). Deployed only once every live secret is
//                   set: without them every route answers 503 (src/config.ts).
// workers_dev is off everywhere. test/deploy-config.test.ts checks all of this.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaaheen-account",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.zaaheen.com", "custom_domain": true }],
  // The renewal sweep (src/sweep.ts), daily at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },
  // Flood protection for /v1/lease and /v1/checkout (src/flood.ts): per
  // client address, per Cloudflare location. Far above real use.
  "ratelimits": [{ "name": "FLOOD", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  // One free trial per email (src/trials.ts, ACCOUNT-DELETION-DESIGN D8):
  // HMAC fingerprint -> first trial start, kept two years. Created 2026-09-29
  // (session 76) as "production-TRIALS". Tests use a local, simulated namespace.
  "kv_namespaces": [{ "binding": "TRIALS", "id": "9226fc5dd07a41fbbae4936d7c33fa21" }],
  // The newest app version, sent beside the lease for the app's "a new version
  // is available" bar (launch checklist B6). Not a secret. Raise it in the
  // same change that publishes a new download.
  "vars": { "LATEST_APP_VERSION": "0.3.0" },
  "env": {
    "sandbox": {
      "name": "zaaheen-account-sandbox",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "api-sandbox.zaaheen.com", "custom_domain": true }],
      "triggers": { "crons": ["17 3 * * *"] },
      // Its own namespace, so sandbox traffic never counts against production.
      "ratelimits": [{ "name": "FLOOD", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }],
      // Its own TRIALS too (sandbox trials never block production ones).
      // Created 2026-09-28 (session 73) as "sandbox-TRIALS".
      "kv_namespaces": [{ "binding": "TRIALS", "id": "51e82fb035fc499ca44cb7afcbd26f8e" }],
      "vars": { "LATEST_APP_VERSION": "0.3.0" }
    }
  }
}
