// The account Worker (SIGNIN-DESIGN.md §5). Not deployed yet. Every
// account-specific value (keys, secrets, Clerk and Paddle ids) is a
// Cloudflare secret, or `.dev.vars` locally (gitignored), never this file
// (§8.30): see `src/config.ts` for the names. Routes arrive with the deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaaheen-account",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The renewal sweep (src/sweep.ts), daily at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] }
}
