# Ask Zaaheen's static files (ADR-SEC-052 §3.5).
# Every path: no sniffing, no referrer out, no caching of the chat page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# The chat page: only zaaheen.com (and later the coaching site) may frame it;
# scripts are ours plus Turnstile's; it talks only to this host.
/chat/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors https://zaaheen.com https://coaching.zaaheen.com
  Cache-Control: no-cache
