# /pay only: Paddle's default payment link (src/pages/pay.astro).
#
# The one exception to the site-wide rule of no third-party requests
# (../.htaccess): Paddle.js loads from Paddle's CDN and shows the checkout in a
# Paddle frame. Everything else stays as strict as the rest of the site.
# scripts/audit.mjs pins this exact policy, so it cannot widen silently.
#
# Apache merges this file after ../.htaccess, so these "set" lines replace the
# parent's values for this folder only. Same long-standing directives as the
# parent: nothing here that LiteSpeed does not support.
#
# Measured against the Paddle sandbox (2026-09-19): on this page Paddle.js
# loads its stylesheet from Paddle's CDN (sandbox-cdn.paddle.com in sandbox)
# and sets inline styles on the overlay; with style-src 'self' the checkout
# rendered as an unstyled box. Hashes would break at Paddle's next release, so
# styles get 'unsafe-inline' here; scripts stay limited to cdn.paddle.com.
# Everything else the checkout loads (card fields, fonts, fraud checks) loads
# inside Paddle's own frame, under Paddle's own policy.

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.paddle.com; style-src 'self' 'unsafe-inline' https://*.paddle.com; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.paddle.com; frame-src https://*.paddle.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Robots-Tag "noindex"
</IfModule>
