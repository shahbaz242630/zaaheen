# zaaheen.com origin: Hostinger web hosting (LiteSpeed), behind Cloudflare.
#
# Keep this file conservative. One directive the server does not support turns
# EVERY request into a 500, robots.txt included, and crawlers treat a 5xx
# robots.txt as "crawl nothing". Only long-standing Apache directives here.
#
# HTTPS is enforced at Cloudflare ("Always Use HTTPS", SSL mode Full (strict)),
# not here: an origin HTTPS redirect behind a proxy is the classic redirect loop.

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical host: the www form redirects once, permanently, to the apex.
  RewriteCond %{HTTP_HOST} ^www\.zaaheen\.com$ [NC]
  RewriteRule ^(.*)$ https://zaaheen.com/$1 [R=301,L]

  # Hostinger's Git deployment can leave repository metadata in the web root.
  RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # No third-party origins at all: fonts, scripts and images are self-hosted.
  # Nothing inline either: scripts/audit.mjs refuses any build with an inline
  # script, style block or style attribute, so this policy can never break a page.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # Pages, robots.txt, sitemap.xml and llms.txt: always revalidate, so a deploy
  # is visible to crawlers at once.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS, JS and fonts only ever ship from /_astro/ with a content hash in the
  # name, so a changed file always has a new URL: cache for a year.
  <FilesMatch "\.(css|js|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
