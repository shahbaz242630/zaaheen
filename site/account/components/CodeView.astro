---
// The email-code step, shared by sign-in and sign-up.
interface Props { button: string }
const { button } = Astro.props;
---
<div class="acct-view" data-view="enter-code" hidden>
  <h1>Check your email.</h1>
  <p class="acct-lede">We sent a 6-digit code to <strong id="code-sent-to"></strong>. It works for 10 minutes.</p>
  <form id="code-form" class="acct-fields" novalidate>
    <div class="acct-field">
      <label for="code">Code</label>
      <input id="code" class="is-code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required>
    </div>
    <button class="acct-btn" type="submit">{button}</button>
  </form>
  <p class="acct-error" role="alert" hidden></p>
  <p class="acct-note" id="code-note" role="status" hidden></p>
  <p class="acct-links">
    <button class="acct-link" id="resend" type="button">Send a new code</button>
    <button class="acct-link" id="different-email" type="button">Use a different email</button>
  </p>
</div>
