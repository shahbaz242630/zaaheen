# account.zaaheen.com origin: Hostinger web hosting (LiteSpeed), behind Cloudflare.
# Written at build time by astro.account.config.mjs (the policy line = accountCsp(host));
# pinned by scripts/audit-account.mjs. AUTH-PAGES-DESIGN D1, D5, ADR-SEC-034.
#
# Only long-standing Apache directives: one the server does not support turns
# every request into a 500 (see public/.htaccess on zaaheen.com).

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The origin has no home page of its own: its front door is sign-in.
  RewriteRule ^$ /sign-in/ [R=302,L]
  RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Robots-Tag "noindex"
  # One policy for the whole origin. No inline script or style (the audit refuses
  # any), Clerk's file is served from here, and Cloudflare's bot check is the
  # only third party (its loader, and the frame it opens). Trusted Types: tt.js,
  # loaded first on every page, is the only policy and allows exactly one
  # script URL, the bot check's loader (build step 1, S1-1).
  Header always set Content-Security-Policy "{{CSP}}"
  Header always set Cache-Control "no-store"
</IfModule>
