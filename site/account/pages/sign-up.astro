---
// 1b Create an account (AUTH-PAGES-DESIGN D1, D6; amendment S1-2 for the
// "one more step" view after Google). No passwords (D2).
import Account from '../layouts/Account.astro';
import CommonViews from '../components/CommonViews.astro';
import CodeView from '../components/CodeView.astro';
import GoogleButton from '../components/GoogleButton.astro';
import { SITE, TRIAL } from '../../src/data/site';

const terms = new URL('/terms/', SITE.origin).href;
const privacy = new URL('/privacy/', SITE.origin).href;
---
<Account title="Create an account" page="sign-up" panel="connect">
  <CommonViews />

  <div class="acct-view" data-view="start" hidden>
    <p class="acct-badge">{TRIAL.days}-day free trial · no card</p>
    <h1>Create your account.</h1>
    <p class="acct-lede">We'll send a code to your email to confirm it's you.</p>
    <form id="start-form" class="acct-fields" novalidate>
      <div class="acct-row">
        <div class="acct-field">
          <label for="first-name">First name</label>
          <input id="first-name" name="first-name" autocomplete="given-name" required>
        </div>
        <div class="acct-field">
          <label for="last-name">Last name</label>
          <input id="last-name" name="last-name" autocomplete="family-name" required>
        </div>
      </div>
      <div class="acct-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
      </div>
      <label class="acct-check"><input id="terms" type="checkbox" required> <span>I agree to the <a href={terms} target="_blank" rel="noopener noreferrer">Terms</a> and the <a href={privacy} target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</span></label>
      <label class="acct-check"><input id="tips" type="checkbox"> <span>Send me occasional tips and product news. You can unsubscribe at any time.</span></label>
      <button class="acct-btn" type="submit">Create account</button>
    </form>
    <p class="acct-error" role="alert" hidden></p>
    <GoogleButton />
    <p class="acct-links">Already have an account? <a href="/sign-in/" data-keep-redirect>Sign in</a></p>
  </div>

  <CodeView button="Confirm and create account" />

  <div class="acct-view" data-view="more-details" hidden>
    <h1>One more step.</h1>
    <p class="acct-lede">We need a little more before your account is ready.</p>
    <form id="details-form" class="acct-fields" novalidate>
      <div class="acct-row">
        <div class="acct-field" data-field="first_name" hidden>
          <label for="more-first-name">First name</label>
          <input id="more-first-name" autocomplete="given-name">
        </div>
        <div class="acct-field" data-field="last_name" hidden>
          <label for="more-last-name">Last name</label>
          <input id="more-last-name" autocomplete="family-name">
        </div>
      </div>
      <label class="acct-check" data-field="legal_accepted" hidden><input id="more-terms" type="checkbox"> <span>I agree to the <a href={terms} target="_blank" rel="noopener noreferrer">Terms</a> and the <a href={privacy} target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</span></label>
      <label class="acct-check" data-field="legal_accepted" hidden><input id="more-tips" type="checkbox"> <span>Send me occasional tips and product news. You can unsubscribe at any time.</span></label>
      <button class="acct-btn" type="submit">Continue</button>
    </form>
    <p class="acct-error" role="alert" hidden></p>
  </div>
  <div id="clerk-captcha"></div>
</Account>
