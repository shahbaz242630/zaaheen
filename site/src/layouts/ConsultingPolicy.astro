---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Placeholder from '../components/Placeholder.astro';
import { CONSULTING, pageFor } from '../data/site';
import { CONSULTING_POLICIES } from '../data/consulting';

// A consulting document (founder s129: the AI Readiness Assessment is "a
// completely different product line", with its own Terms, Privacy and Refund
// policies, written after research). Until a document is written its page
// is a placeholder; scripts/audit.mjs --release refuses to publish one.
interface Props {
  path: string;
  heading: string;
  /** What the finished document will cover, shown in the placeholder. */
  covers: string;
}
const { path, heading, covers } = Astro.props;
const page = pageFor(path);
---
<Base page={page} footer="consulting">
  <div class="page">
    <Breadcrumbs page={page} />
    <h1>{heading}</h1>
    <Placeholder>{covers}</Placeholder>
    <p>Questions in the meantime: <a href={`mailto:${CONSULTING.email}`}>{CONSULTING.email}</a>.</p>
    <p class="fine">The other consulting documents:
      {CONSULTING_POLICIES.filter((p) => p.path !== path).map((p, i) => (
        <>{i > 0 && ' · '}<a href={p.path}>{p.label}</a></>
      ))}
    </p>
  </div>
</Base>
