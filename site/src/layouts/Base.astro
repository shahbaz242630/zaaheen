---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import { SITE, NAV, ACCOUNT, RELEASE, absolute, type PageEntry } from '../data/site';
import { firstPublished, lastModified } from '../lib/lastmod';
import { graphFor } from '../lib/seo';

interface Props {
  page: PageEntry;
  /** Only for pages that must never be indexed: the 404 page and /pay (UNLISTED in scripts/audit.mjs). */
  noindex?: boolean;
  /** "coaching" only on the Knowledge Centre's pages (components/Footer.astro). */
  footer?: 'app' | 'coaching';
}

const { page, noindex = false, footer = 'app' } = Astro.props;
const canonical = absolute(page.path);
const jsonLd = noindex ? null : graphFor(page, lastModified(page.path), page.heading ? firstPublished(page.sources) : undefined);
---
<!doctype html>
<html lang={SITE.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{page.title}</title>
<meta name="description" content={page.description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
{/* Full-length snippets and large image previews in search and AI answers; restricts nothing (SEO-HANDOFF §1 step 4). */}
{!noindex && <meta name="robots" content="max-snippet:-1, max-image-preview:large">}
<meta name="theme-color" content={SITE.themeColor}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE.name}>
<meta property="og:locale" content={SITE.locale}>
<meta property="og:title" content={page.title}>
<meta property="og:description" content={page.description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={absolute(SITE.ogImage)}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={SITE.ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
</head>
<body>

<header class="site-head">
  <div class="bar">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <Logo size={48} />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} aria-current={page.path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <!-- Our own account pages on account.zaaheen.com (AUTH-PAGES-DESIGN D1).
         "Get started" only while the app can be downloaded: before that, a new
         account has nothing to open (founder, session 75). "Account" opens the
         account page, which signs in first when needed (AUTH-PAGES-DESIGN
         S85-1, founder s85: the app's Account tab on the website). -->
    <div class="bar-actions">
      <a class="bar-signin" href={ACCOUNT.page}>Account</a>
      {RELEASE.available
        ? <a class="bar-start" href={ACCOUNT.signUp}>Get started</a>
        : <span class="bar-start bar-soon"><span class="bar-soon-long">Coming soon for Windows and Mac</span><span class="bar-soon-short">Coming soon</span></span>}
    </div>
  </div>
</header>

<main>
  <slot />
</main>

<Footer variant={footer} />

</body>
</html>
