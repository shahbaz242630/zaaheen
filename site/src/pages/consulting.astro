---
import Base from '../layouts/Base.astro';
import { CONSULTING, pageFor } from '../data/site';
import {
  CONSULTING_HERO as HERO, CONSULTING_PROBLEM as PROBLEM, CONSULTING_STEPS as STEPS, CONSULTING_GIVES as GIVES,
  CONSULTING_VERDICTS as VERDICTS, CONSULTING_TEAMS as TEAMS, CONSULTING_WHO as WHO, CONSULTING_WHY_US as WHY,
  CONSULTING_INDEPENDENT as INDEP, CONSULTING_FAQ as FAQ, CONSULTING_CLOSE as CLOSE,
} from '../data/consulting';

// The AI Readiness Assessment (notes ai-assessment/AI-ASSESSMENT-DESIGN.md
// §1 and §4, ADR-121). English only, its own footer (founder s129: "a
// completely different product line"). Design chosen by the founder in s129:
// "the busy desk, sorted" with the example report page in What you get.
// Every word comes from data/consulting.ts, which llms.txt reads too.
// No inline script or style (CSP): the desk moves in scripts/consulting.js,
// and the HTML already holds the sorted desk, so without script or with
// reduced motion the picture is simply still and complete.
// The form lives on consulting.zaaheen.com (workers/consulting), so this
// page's strict policy (connect-src and form-action 'self') never widens.
const page = pageFor('/consulting/');
const book = CONSULTING.enquiryUrl;

// Illustrative everyday work, not findings about any client.
const SLIPS = [
  { kind: 'Answering', text: 'Answer “where is my order?” again', tray: 'ai' },
  { kind: 'Sorting', text: 'Sort the shared inbox every morning', tray: 'ai' },
  { kind: 'Copying', text: 'Copy invoice totals into the ledger', tray: 'auto' },
  { kind: 'Checking', text: 'Check a refund against the policy', tray: 'auto' },
  { kind: 'Chasing', text: 'Chase a supplier for a delivery date', tray: 'fix' },
  { kind: 'Finding', text: 'Find who signed off the last price change', tray: 'fix' },
  { kind: 'Approving', text: 'Approve a discount over the limit', tray: 'leave' },
  { kind: 'Deciding', text: 'Settle a difficult complaint', tray: 'leave' },
];

// The example report page in What you get. Illustrative, and labelled so.
const FLOW = [
  { step: 'Invoice arrives', time: 'by email' },
  { step: 'Key it in', time: '6 min' },
  { step: 'Wait for approval', time: '2 days', wait: true },
  { step: 'Pay', time: '3 min' },
];
const ROWS = [
  { step: 'Key in each invoice', id: 'ai', meta: 'Effort low · 38 h a month · pays back in 3 months' },
  { step: 'Match to the order', id: 'auto', meta: 'Effort low · 22 h a month · pays back in 2 months' },
  { step: 'Chase approvals', id: 'fix', meta: 'No clear owner · fix before any tool' },
  { step: 'Supplier disputes', id: 'leave', meta: 'Judgement call · stays with your team' },
];
const verdictName = (id: string) => VERDICTS.find((v) => v.id === id)?.name ?? id;
---
<Base page={page} footer="consulting">
  <section class="cd-hero">
    <div class="cd-hero-copy">
      <div class="cd-hero-title">
        <p class="cd-name"><span class="cd-name-dot"></span>{HERO.name}</p>
        <h1>{HERO.title}</h1>
      </div>
      <div class="cd-hero-text">
        <p class="cd-lede">{HERO.lede}</p>
        <p class="cd-lede cd-lede-2">{HERO.then}</p>
        <div class="cd-cta-row">
          <a class="cd-cta" href={book}>Book a free 30-minute call</a>
          <span class="cd-cta-meta">{HERO.where}</span>
        </div>
        <ul class="cd-promises">
          {HERO.promises.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>

    <figure class="cd-desk" id="cd-desk" aria-labelledby="cd-desk-cap">
      <div class="cd-desk-bar">
        <span class="cd-desk-dot"></span><span class="cd-desk-dot"></span><span class="cd-desk-dot"></span>
        <span class="cd-desk-title">Example: one busy desk, sorted</span>
        <button class="cd-pause" type="button" aria-pressed="false" hidden>Pause</button>
      </div>
      <div class="cd-desk-body">
        <ul class="cd-pile" aria-hidden="true"><li class="cd-pile-label">This week's pile</li></ul>
        <div class="cd-trays">
          {VERDICTS.map((t) => (
            <div class={`cd-tray is-${t.id}`} data-tray={t.id}>
              <p class="cd-tray-name"><span class="cd-mark"></span>{t.name}</p>
              <ul class="cd-tray-list" data-tray-list={t.id}>
                {SLIPS.filter((s) => s.tray === t.id).map((s) => (
                  <li class="cd-slip" data-tray={s.tray}>
                    <span class="cd-slip-face">
                      <span class="cd-slip-kind">{s.kind}</span>
                      <span class="cd-slip-text">{s.text}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <figcaption id="cd-desk-cap" class="cd-desk-cap">An example of everyday work on one desk, sorted into the four verdicts we give.</figcaption>
    </figure>
  </section>

  <section class="cd-band cd-why">
    <div class="cd-wrap cd-why-grid">
      <h2 class="cd-h2">{PROBLEM.title}</h2>
      <div class="cd-why-facts">
        <p class="cd-fact">Boston Consulting Group found that <strong>74%</strong> of companies had yet to see real value from AI,</p>
        <p class="cd-fact">and that about <strong>70%</strong> of the challenge lies in people and processes, not in the technology.</p>
        <p class="cd-body">{PROBLEM.research}</p>
        <p class="cd-note-slip">{PROBLEM.demo}</p>
      </div>
    </div>
  </section>

  <section class="cd-band is-white" id="how">
    <div class="cd-wrap">
      <h2 class="cd-h2 cd-h2-narrow">Four steps, from the first call to a plan you can act on.</h2>
      <ol class="cd-story">
        {STEPS.map((s, i) => (
          <li class="cd-frame">
            <div class="cd-art" aria-hidden="true">
              {s.art === 'call' && (
                <svg viewBox="0 0 200 140" class="cd-svg">
                  <rect x="34" y="24" width="48" height="88" rx="9" />
                  <line x1="50" y1="34" x2="66" y2="34" />
                  <circle cx="58" cy="100" r="4" />
                  <rect x="98" y="30" width="78" height="30" rx="12" class="cd-fill-soft" />
                  <line x1="110" y1="41" x2="160" y2="41" /><line x1="110" y1="50" x2="144" y2="50" />
                  <path d="M106 60 l-6 9 l12 -9" class="cd-fill-soft" />
                  <rect x="112" y="76" width="66" height="26" rx="11" class="cd-fill-sage" />
                  <line x1="124" y1="86" x2="164" y2="86" class="cd-on-sage" /><line x1="124" y1="93" x2="150" y2="93" class="cd-on-sage" />
                  <circle cx="160" cy="122" r="11" /><polyline points="160,115 160,122 166,125" />
                </svg>
              )}
              {s.art === 'walk' && (
                <svg viewBox="0 0 200 140" class="cd-svg">
                  <path d="M16 70 C 50 44, 84 96, 118 66 S 150 50, 150 50" class="cd-dash" />
                  <rect x="12" y="104" width="44" height="8" rx="2" /><rect x="22" y="88" width="22" height="16" rx="2" />
                  <rect x="74" y="104" width="44" height="8" rx="2" /><rect x="84" y="88" width="22" height="16" rx="2" />
                  <rect x="136" y="104" width="44" height="8" rx="2" /><rect x="146" y="88" width="22" height="16" rx="2" />
                  <rect x="146" y="14" width="38" height="50" rx="4" class="cd-fill-paper" />
                  <rect x="157" y="9" width="16" height="9" rx="2" class="cd-fill-sage" />
                  <polyline points="153,30 157,34 164,26" class="cd-sage" /><line x1="168" y1="30" x2="178" y2="30" />
                  <polyline points="153,44 157,48 164,40" class="cd-sage" /><line x1="168" y1="44" x2="178" y2="44" />
                  <line x1="153" y1="56" x2="178" y2="56" />
                </svg>
              )}
              {s.art === 'map' && (
                <svg viewBox="0 0 200 140" class="cd-svg">
                  <rect x="8" y="34" width="46" height="26" rx="6" class="cd-fill-paper" />
                  <rect x="78" y="34" width="46" height="26" rx="6" class="cd-fill-sage" />
                  <rect x="148" y="34" width="46" height="26" rx="6" class="cd-fill-paper" />
                  <rect x="78" y="96" width="46" height="26" rx="6" class="cd-fill-paper" />
                  <line x1="54" y1="47" x2="74" y2="47" /><polyline points="69,43 74,47 69,51" />
                  <line x1="124" y1="47" x2="144" y2="47" class="cd-dash" /><polyline points="139,43 144,47 139,51" />
                  <line x1="101" y1="60" x2="101" y2="92" /><polyline points="97,87 101,92 105,87" />
                  <line x1="132" y1="41" x2="132" y2="53" class="cd-thick" /><line x1="137" y1="41" x2="137" y2="53" class="cd-thick" />
                  <text x="31" y="22" class="cd-svg-text">3 min</text>
                  <text x="101" y="22" class="cd-svg-text">6 min</text>
                  <text x="171" y="22" class="cd-svg-text">wait</text>
                </svg>
              )}
              {s.art === 'report' && (
                <svg viewBox="0 0 200 140" class="cd-svg">
                  <rect x="18" y="12" width="70" height="96" rx="5" class="cd-fill-paper" />
                  <line x1="30" y1="26" x2="66" y2="26" class="cd-thick" />
                  <rect x="30" y="58" width="10" height="26" class="cd-fill-sage" />
                  <rect x="46" y="44" width="10" height="40" class="cd-fill-sage" />
                  <rect x="62" y="66" width="10" height="18" class="cd-fill-sage" />
                  <line x1="30" y1="94" x2="76" y2="94" />
                  <ellipse cx="146" cy="110" rx="42" ry="12" class="cd-fill-paper" />
                  <circle cx="116" cy="74" r="8" /><path d="M104 96 q12 -14 24 0" />
                  <circle cx="146" cy="66" r="8" /><path d="M134 88 q12 -14 24 0" />
                  <circle cx="176" cy="74" r="8" /><path d="M164 96 q12 -14 24 0" />
                </svg>
              )}
            </div>
            <span class="cd-frame-no">Step {i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cd-band">
    <div class="cd-wrap">
      <div class="cd-head">
        <h2 class="cd-h2">A clear verdict for every team, not a list of tools.</h2>
        <p class="cd-body">{GIVES}</p>
      </div>
      <div class="cd-get">
        <figure class="cd-sheet" id="cd-sheet" aria-labelledby="cd-sheet-title">
          <div class="cd-sheet-top">
            <span class="cd-sheet-tag">Example page</span>
            <span class="cd-sheet-no">From the report</span>
          </div>
          <p class="cd-sheet-title" id="cd-sheet-title">Accounts payable</p>
          <p class="cd-sheet-sub">How an invoice gets paid today, timed on site</p>
          <ol class="cd-flow">
            {FLOW.map((f) => (
              <li class={f.wait ? 'cd-flow-step is-wait' : 'cd-flow-step'}>
                <span class="cd-flow-name">{f.step}</span>
                <span class="cd-flow-time">{f.time}</span>
              </li>
            ))}
          </ol>
          <ul class="cd-vrows">
            {ROWS.map((r) => (
              <li class="cd-vrow">
                <span class="cd-vstep">{r.step}</span>
                <span class={`cd-chip is-${r.id}`}><span class="cd-mark"></span>{verdictName(r.id)}</span>
                <span class="cd-vmeta">{r.meta}</span>
              </li>
            ))}
          </ul>
          <figcaption class="cd-sheet-foot">An example of a department page from the report. The figures are illustrative.</figcaption>
        </figure>
        <ul class="cd-verdicts">
          {VERDICTS.map((t) => (
            <li class={`cd-verdict is-${t.id}`}>
              <p class="cd-tray-name"><span class="cd-mark"></span>{t.name}</p>
              <p>{t.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="cd-band is-white">
    <div class="cd-wrap cd-who">
      <div class="cd-who-copy">
        <h2 class="cd-h2">{WHO.title}</h2>
        <p class="cd-body">{WHO.intro}</p>
      </div>
      <ul class="cd-tags">
        {TEAMS.map((t) => <li class="cd-tag">{t}</li>)}
      </ul>
      <p class="cd-who-line">{WHO.line}</p>
    </div>
  </section>

  <section class="cd-band">
    <div class="cd-wrap">
      <article class="cd-letter">
        <span class="cd-mono" aria-hidden="true">Z</span>
        <h2 class="cd-h2">{WHY.title}</h2>
        {WHY.paras.map((p) => <p>{p}</p>)}
        <p class="cd-sign">{WHY.sign}</p>
      </article>
    </div>
  </section>

  <section class="cd-band is-white">
    <div class="cd-wrap">
      <h2 class="cd-h2 cd-h2-narrow">{INDEP.title}</h2>
      <div class="cd-indep">
        <div class="cd-col">
          <h3>We do not</h3>
          <ul class="cd-checks">
            {INDEP.not.map((n) => (
              <li class="is-no">
                <svg viewBox="0 0 20 20" class="cd-ico" aria-hidden="true"><line x1="6" y1="6" x2="14" y2="14" /><line x1="14" y1="6" x2="6" y2="14" /></svg>
                <span>{n}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="cd-col">
          <h3>Instead</h3>
          <ul class="cd-checks">
            {INDEP.instead.map((n) => (
              <li class="is-yes">
                <svg viewBox="0 0 20 20" class="cd-ico" aria-hidden="true"><polyline points="5,10.5 8.5,14 15,6.5" /></svg>
                <span>{n}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="cd-band" id="questions">
    <div class="cd-wrap cd-faq">
      <h2 class="cd-h2">Questions</h2>
      <div class="cd-faq-list">
        {FAQ.map((f) => (
          <details class="cd-faq-item">
            <summary>{f.q}<span class="cd-plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cd-close">
    <h2 class="cd-h2">{CLOSE.title}</h2>
    <p>{CLOSE.body}</p>
    <a class="cd-cta" href={book}>Book a free 30-minute call</a>
    <p class="cd-contact">Prefer email? Write to <a href={`mailto:${CONSULTING.email}`}>{CONSULTING.email}</a>.
       How we handle your enquiry: our <a href="/consulting/privacy/">Privacy Policy</a>.</p>
  </section>

  <script src="../scripts/consulting.js"></script>
</Base>

<style is:global>
  :root{
    --cd-ai:var(--sage-deep); --cd-auto:var(--ink-soft); --cd-fix:#b98a4e; --cd-leave:#a69e90;
    /* "Fix the process first" text on its own tint: 5.1:1. */
    --cd-fix-text:#8a5a1c; --cd-fix-bg:#f8efe0; --cd-fix-line:#e6cfa8;
    --cd-ease:cubic-bezier(.22,.8,.24,1);
  }
  .cd-wrap{max-width:1180px;margin:0 auto;padding:0 32px}
  .cd-h2{font:450 clamp(30px,3.8vw,42px)/1.14 var(--serif);letter-spacing:-.015em;margin:0;text-wrap:balance}
  .cd-h2-narrow{max-width:680px}
  .cd-body{margin:0;font-size:17px;line-height:1.65;color:var(--ink-soft);max-width:62ch;text-wrap:pretty}
  .cd-band{padding:104px 0;border-top:1px solid var(--line);scroll-margin-top:8px}
  .cd-band.is-white{background:var(--card)}

  /* ---------- hero ---------- */
  /* The hero: the words across the top, the desk full width below them
     (founder s129: "make it wide and more eye catching"). */
  .cd-hero{max-width:1180px;margin:0 auto;padding:52px 32px 88px;display:flex;flex-direction:column;gap:40px}
  .cd-hero-copy{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:8px 64px;align-items:center}
  .cd-hero-title,.cd-hero-text{display:flex;flex-direction:column}
  .cd-hero-title h1{margin-bottom:0}
  .cd-hero-text .cd-lede{max-width:none;font-size:17.5px}
  .cd-hero-text .cd-lede-2{margin-bottom:24px}
  .cd-hero-text .cd-promises{margin-top:24px;padding-top:16px;gap:6px 20px;font-size:14px}
  .cd-name{display:inline-flex;align-self:flex-start;align-items:center;gap:8px;margin:0 0 22px;
    padding:5px 12px 5px 10px;border-radius:999px;background:var(--tint);border:1px solid var(--tint-line);
    font:500 13.5px var(--sans);color:var(--sage-text)}
  .cd-name-dot{width:7px;height:7px;border-radius:50%;background:var(--sage-deep)}
  .cd-hero h1{font:450 clamp(40px,5.2vw,62px)/1.06 var(--serif);letter-spacing:-.02em;margin:0 0 24px;text-wrap:balance}
  .cd-lede{font-size:18.5px;line-height:1.6;color:var(--ink-soft);max-width:500px;margin:0 0 14px;text-wrap:pretty}
  .cd-lede-2{color:var(--ink);font-weight:500;margin-bottom:32px}
  .cd-cta-row{display:flex;gap:18px;align-items:center;flex-wrap:wrap}
  .cd-cta{display:inline-block;background:var(--ink);color:var(--paper);text-decoration:none;padding:14px 30px;
    border-radius:999px;font:500 16px var(--sans);transition:background .15s,transform .2s var(--cd-ease)}
  .cd-cta:hover{background:var(--ink-soft);transform:translateY(-1px)}
  .cd-cta-meta{font:400 13px var(--mono);color:var(--faint)}
  .cd-promises{list-style:none;display:flex;flex-wrap:wrap;gap:10px 24px;margin:44px 0 0;padding:22px 0 0;
    border-top:1px solid var(--line);font-size:14.5px;color:var(--muted)}
  .cd-promises li{display:flex;align-items:center;gap:8px}
  .cd-promises li::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--sage)}

  /* The desk: the home page's window frame, a desk surface inside. */
  .cd-desk{margin:0;background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;
    box-shadow:0 24px 60px rgba(38,34,28,.10),0 2px 6px rgba(38,34,28,.04);min-width:0}
  .cd-desk-bar{display:flex;align-items:center;gap:8px;padding:11px 14px 11px 16px;background:var(--win-bar);border-bottom:1px solid var(--line)}
  .cd-desk-dot{width:10px;height:10px;border-radius:50%;background:var(--border)}
  .cd-desk-title{margin-left:8px;font:400 12px var(--mono);color:var(--faint);flex:1;min-width:0;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cd-pause{border:1px solid var(--border);background:var(--card);color:var(--ink);border-radius:999px;
    padding:3px 12px;font:500 12.5px var(--sans);cursor:pointer}
  .cd-pause:hover{border-color:var(--ink)}
  .cd-desk-body{background:var(--panel);padding:20px;display:flex;flex-direction:column;gap:16px}
  /* The pile's height is set by scripts/consulting.js to fit two tidy columns. */
  .cd-pile{display:none;position:relative;min-height:110px;margin:0;padding:0;list-style:none;border-radius:12px;
    border:1px dashed var(--border);background:rgba(255,255,255,.35)}
  .cd-desk.is-live .cd-pile{display:block}
  .cd-pile-label{position:absolute;right:12px;bottom:8px;font:400 11.5px var(--mono);color:var(--faint)}
  .cd-trays{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  /* Each tray carries its verdict's colour as a band along the top. */
  .cd-tray{position:relative;background:var(--paper);border:1px solid var(--border);border-radius:12px;
    padding:16px 12px 12px;box-shadow:inset 0 2px 0 rgba(38,34,28,.03);
    transition:background .4s,border-color .4s,box-shadow .4s,transform .4s var(--cd-ease)}
  /* No overflow:hidden on the tray: it would clip a slip flying in. */
  .cd-tray::before{content:"";position:absolute;left:-1px;right:-1px;top:-1px;height:5px;border-radius:12px 12px 0 0;background:var(--cd-ai)}
  .cd-tray.is-auto::before{background:var(--cd-auto)} .cd-tray.is-fix::before{background:var(--cd-fix)} .cd-tray.is-leave::before{background:var(--cd-leave)}
  .cd-tray.is-hit{background:var(--card);border-color:var(--sage);transform:translateY(-2px);
    box-shadow:0 2px 4px rgba(38,34,28,.05),0 12px 24px rgba(38,34,28,.08)}
  .cd-tray-name{display:flex;align-items:center;gap:8px;margin:0 0 8px;font:500 13.5px var(--sans);color:var(--ink)}
  .cd-mark{width:10px;height:10px;border-radius:3px;flex:none;background:var(--cd-ai)}
  .is-auto .cd-mark{background:var(--cd-auto)} .is-fix .cd-mark{background:var(--cd-fix)} .is-leave .cd-mark{background:var(--cd-leave)}
  .cd-tray-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
  .cd-slip{display:block;will-change:transform}
  .cd-slip.is-piled{position:absolute;z-index:1}
  .cd-slip.is-moving{z-index:6;position:relative}
  .cd-slip.is-piled.is-moving{position:absolute}
  .cd-slip-face{display:flex;flex-direction:column;gap:2px;background:var(--card);border:1px solid var(--line);
    border-radius:7px;padding:7px 10px 8px;box-shadow:0 1px 2px rgba(38,34,28,.06),0 4px 10px rgba(38,34,28,.05);
    transition:transform .6s var(--cd-ease),box-shadow .6s}
  .is-piled .cd-slip-face{box-shadow:0 2px 4px rgba(38,34,28,.08),0 8px 18px rgba(38,34,28,.08)}
  .cd-slip-kind{font:400 10.5px var(--mono);letter-spacing:.02em;color:var(--faint)}
  .cd-slip-text{font-size:13.5px;line-height:1.35;color:var(--ink)}
  .cd-desk-cap{padding:10px 16px 12px;font-size:13px;color:var(--muted);background:var(--card);border-top:1px solid var(--line)}

  /* ---------- the problem ---------- */
  .cd-why-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:56px;align-items:start}
