---
import Policy, { type Outline } from '../layouts/Policy.astro';
import Row from '../components/Row.astro';
import { ACCOUNT, COMPANY, PLANS, SITE, TRIAL } from '../data/site';

// The Terms of Service (founder, session 67; hardened in session 69 from two
// independent research reports, LEGAL-DOCUMENTS-DESIGN.md). No lawyer
// (founder), so wherever the law is unclear we take the reading kindest to
// the customer: no arbitration, changes only with notice, termination only
// for cause, and nothing that limits rights the law gives. The founder's
// session 69 rule: honest with users, and closed against gaming (decisions L1
// to L6). The facts match the app (crates/vault-tauri/dist: Download my
// memories is a readable file with no import; Delete my account in the app
// erases this computer's memories first; tidying marks replaced memories and
// never erases them) and the account Worker (30-day trial, 30-day offline
// lease). Paddle's reseller sentence is the one its seller handbook asks for,
// word for word.
const OUTLINE: Outline[] = [
  { id: 'agreement', title: 'About these terms', topics: [
    { id: 'who', title: 'Who we are' },
    { id: 'accepting', title: 'Agreeing to these terms' },
    { id: 'age', title: 'Who can use Zaaheen' },
  ] },
  { id: 'app', title: 'The Zaaheen app', topics: [
    { id: 'licence', title: 'Your licence to use Zaaheen' },
    { id: 'ownership', title: 'Who owns what' },
    { id: 'beta', title: 'Zaaheen is in beta' },
    { id: 'fair-use', title: 'Using Zaaheen fairly' },
    { id: 'sanctions', title: 'Sanctions and export rules' },
  ] },
  { id: 'subscription', title: 'Trial and subscription', topics: [
    { id: 'trial', title: 'Your free trial' },
    { id: 'plans', title: 'Plans, prices and renewal' },
    { id: 'reseller', title: 'Who takes your payment' },
    { id: 'cancel', title: 'How to cancel' },
    { id: 'ends', title: 'When a trial or subscription ends' },
  ] },
  { id: 'data', title: 'Your memories', topics: [
    { id: 'yours', title: 'Your memories are yours' },
    { id: 'backups', title: 'Keeping a copy of your memories' },
    { id: 'ai-limits', title: "What Zaaheen's AI can get wrong" },
    { id: 'ai-apps', title: 'The AI apps you connect' },
  ] },
  { id: 'legal', title: 'The legal part', topics: [
    { id: 'responsibility', title: 'What we are responsible for' },
    { id: 'closing', title: 'Closing an account' },
    { id: 'stopping', title: 'If we stop offering Zaaheen' },
    { id: 'changes', title: 'Changes to Zaaheen and these terms' },
    { id: 'general', title: 'General terms' },
    { id: 'websites', title: 'Our websites' },
    { id: 'disputes', title: 'Law and disputes' },
    { id: 'contact', title: 'Contact us' },
  ] },
];
const topic = (id: string) =>
  OUTLINE.flatMap((s) => s.topics).find((t) => t.id === id)?.title ?? id;
const mail = `mailto:${COMPANY.email}`;
const lede = `These are the terms for using ${SITE.name}, the private memory for your AI apps. We have kept them as short and plain as we can.`;
---
<Policy path="/terms/" heading="Terms of Service" lede={lede} outline={OUTLINE}>
  <ul slot="summary">
    <li>Your first {TRIAL.days} days are free, with no card. After that Zaaheen is {PLANS.monthly}
        or {PLANS.yearly}, renewing until you cancel.</li>
    <li>You can cancel at any time in the app, and you keep access until the end of the time
        you've paid for.</li>
    <li>We refund your latest payment in full if you ask within 14 days of being charged, once
        per person.</li>
    <li>Your memories are yours. They stay on your computer, and you can download them even if
        you stop paying. We hold no copy, so keeping a copy is up to you.</li>
    <li>Nothing here takes away the rights the law gives you where you live.</li>
  </ul>

  <section id="agreement" class="docs-section">
    <h2 class="docs-title">About these terms</h2>

    <Row id="who" title={topic('who')} where={COMPANY.city}>
      <p>{SITE.name} is the trading name of {COMPANY.legalName}, a business licensed in Dubai,
         United Arab Emirates ({COMPANY.licence}). "We" and "us" in these terms mean us, and "you"
         means the person using Zaaheen.</p>
    </Row>

    <Row id="accepting" title={topic('accepting')} where="Your account">
      <p>These terms are an agreement between you and us about the Zaaheen app, your Zaaheen
         account, your subscription and our websites. You agree to them when you create your
         account. Our <a href="/privacy/">Privacy Policy</a> and <a href="/refunds/">Refund
         Policy</a> are part of them.</p>
      <p>Coaching sessions from our Knowledge Centre are a separate purchase with their own
         terms, which you see before you book.</p>
    </Row>

    <Row id="age" title={topic('age')} where="18 and over">
      <p>You must be 18 or over, and able to make a binding contract, to create an account. By
         creating an account you confirm that you are. Zaaheen is for your own use: the account
         is yours alone and must not be shared.</p>
    </Row>
  </section>

  <section id="app" class="docs-section">
    <h2 class="docs-title">The Zaaheen app</h2>

    <Row id="licence" title={topic('licence')} where="Windows and Mac">
      <p>While you have an active trial or subscription, we give you a personal, non-exclusive
         licence to install Zaaheen on the computers you use and to use it for yourself,
         including for your own work.</p>
      <p>When your trial or subscription ends, the licence continues for one purpose only:
         opening Zaaheen to download your memories (<em>Download my memories</em>) or delete all
         of them (<em>Delete everything</em>). The licence cannot be sold, transferred or
         shared.</p>
    </Row>

    <Row id="ownership" title={topic('ownership')} where="Our work">
      <p>We own Zaaheen, its name and logo, our websites and everything we create for them. Some
         parts of Zaaheen are open-source software and AI models made by others. Their own
         licences govern those parts, and their notices ship with the app, as our <a
         href="/licences/">Open-source licences</a> page explains.</p>
      <p>If you send us ideas or suggestions, we can use them to improve Zaaheen without paying
         you. This never covers your memories, which stay yours.</p>
    </Row>

    <Row id="beta" title={topic('beta')} where="Beta">
      <p>Zaaheen is beta software. It works, and we use it every day, but it has not had the
         testing a finished product gets. Expect bugs, changes to features and the occasional
         update you need to install. We supply it with reasonable care and skill, it matches the
         description on our website, and we fix problems as quickly as we can. Beyond that, and
         as far as the law allows, we do not promise that it is free of errors or always
         available.</p>
      <p>We design every update so that <em>Download my memories</em> keeps working, including
         after a trial or subscription ends. If a problem ever stops it working, fixing that comes
         first.</p>
      <p>Do not rely on Zaaheen as the only place you keep information that matters, such as
         medical, legal, financial or work records.</p>
    </Row>

    <Row id="fair-use" title={topic('fair-use')} where="Do not">
      <p>Use Zaaheen lawfully and for yourself. Do not:</p>
      <ul>
        <li>use it to break the law, or to store information about other people that you have no
            right to keep;</li>
        <li>use it to harass, defraud or harm anyone;</li>
        <li>get around the trial, the subscription or any limit in the app, or share your
            account;</li>
        <li>copy, sell, rent, sublicense or distribute Zaaheen, or offer it as a service to
            others;</li>
        <li>take the app apart, decompile it or change it, except where the law allows you
            to;</li>
        <li>overload, probe, attack or try to break into our servers, our websites or anyone
            else's account;</li>
        <li>use Zaaheen in a way that breaks the terms of the AI apps you connect.</li>
      </ul>
      <p>You are responsible for what you and your AI apps save in Zaaheen.</p>
    </Row>

    <Row id="sanctions" title={topic('sanctions')} where="Everyone">
      <p>You must not download or use Zaaheen if you are located in, or ordinarily live in, a
         country or region under comprehensive sanctions, or if you are named on a sanctions list
         of the United Nations, the United Arab Emirates, the European Union, the United Kingdom
         or the United States. You must not export Zaaheen in breach of any export law. We close
         an account where these rules require it.</p>
    </Row>
  </section>

  <section id="subscription" class="docs-section">
    <h2 class="docs-title">Trial and subscription</h2>

    <Row id="trial" title={topic('trial')} where="No card needed">
      <p>Your {TRIAL.days}-day free trial starts the first time you sign in from the Zaaheen app. We
         don't ask for a
         card, so nothing is charged when it ends: Zaaheen simply asks you to subscribe. One trial
         per person.</p>
    </Row>

    <Row id="plans" title={topic('plans')} where="Monthly or yearly">
      <p>Zaaheen is {PLANS.monthly} or {PLANS.yearly}, plus VAT or sales tax where it applies,
         collected by our reseller Paddle. You see the exact total before you pay.</p>
      <p>Your subscription renews automatically at the end of each month or year, at the same
         price, until you cancel. If we change the price, we email you at least 30 days before
         your first payment at the new price, and the new price applies from your next renewal
         after that email. If you don't want to pay it, cancel before that renewal and you pay
         nothing more. Where the law where you live requires it, you also receive a reminder
         before a yearly plan renews.</p>
    </Row>

    <Row id="reseller" title={topic('reseller')} where="Paddle">
      <p>For the Zaaheen app and your subscription: Our order process is conducted by our online
         reseller Paddle.com. Paddle.com is the Merchant of Record for all our orders. Paddle
         provides all customer service inquiries and handles returns.</p>
      <p>That means Paddle is the seller in your purchase, handles payment and tax, and sends
         your receipts, under <a href="https://www.paddle.com/legal/buyer-terms" target="_blank"
         rel="noopener noreferrer">Paddle's buyer terms</a>. You can still email us about anything
         to do with your subscription, and we will help. Coaching sessions are sold by us
         directly under their own terms, and Paddle has no part in them.</p>
    </Row>

    <Row id="cancel" title={topic('cancel')} where="Settings › Account">
      <p>In the app: <em>Settings › Account › Cancel subscription</em>. On the website:
         <em>Account</em>, then <em>Cancel subscription</em>. Or use the cancel link in any email
         from Paddle, our reseller, which works from any device. Cancelling stops the next
         renewal, and you keep access until the end of the time you've already paid for.</p>
      <p>We do not refund the unused part of a month or a year, except where these terms say so.
         Refunds are covered by our <a href="/refunds/">Refund Policy</a>.</p>
    </Row>

    <Row id="ends" title={topic('ends')} where="Nothing is deleted">
      <p>If your trial ends or your subscription stops, Zaaheen stops serving your AI apps until
         you subscribe. Nothing is deleted. Everything you kept stays on your computer, and
         <em>Download my memories</em> keeps working, so you can always take your memories with
         you.</p>
      <p>The app checks your subscription with us now and then, and keeps working offline for up
         to 30 days between checks.</p>
    </Row>
  </section>

  <section id="data" class="docs-section">
    <h2 class="docs-title">Your memories</h2>

    <Row id="yours" title={topic('yours')} where="On your computer">
      <p>Everything you and your AI apps save to Zaaheen belongs to you. We claim no rights to it,
         we never receive it, and we can't read it. How we handle the little we do hold is in our
         <a href="/privacy/">Privacy Policy</a>.</p>
    </Row>

    <Row id="backups" title={topic('backups')} where="Your copy">
      <p>Your memories live only on your computer, locked with a key that Windows or macOS
         keeps for your user account on that computer. We hold no copy, so we cannot restore
         them for you.</p>
      <p>You lose your memories if the computer is lost, stolen or damaged, if the drive fails,
         if you delete the memory folder, or if your user account or the computer's operating
         system (Windows or macOS) is removed or reinstalled. Copying the memory folder does not protect you against this,
         because the copy cannot be opened without the key.</p>
      <p><em>Download my memories</em> saves everything you have kept as one file that you can
         read. Save one regularly and keep it somewhere safe. The file is not encrypted, so
         anyone who gets it can read it. Zaaheen cannot load that file back in today.</p>
      <p><em>Delete everything</em> is permanent. It destroys the key and the memory files on
         that computer, and no one, including us, can undo it. It does not delete files you saved
         with <em>Download my memories</em>; delete those yourself if you no longer want
         them.</p>
    </Row>

    <Row id="ai-limits" title={topic('ai-limits')} where="On your computer">
      <p>Zaaheen uses AI on your computer to find memories and, when tidying is on, to tidy them.
         Search can miss a memory or return one that does not fit the question. Tidying merges
         near duplicates, rewords memories when it merges them, settles facts that contradict
         each other in favour of the newer one, and writes short summaries. It keeps the older
         version rather than erasing it, but it can get a merge, a summary or a choice between
         two facts wrong.</p>
      <p>Your AI apps can also save a memory that is wrong or that you did not mean to keep.
         Check anything important before you act on it, and correct or delete a memory that is
         wrong. Zaaheen stores and finds facts. It does not give medical, legal, financial or
         other professional advice, and nothing it returns is advice.</p>
    </Row>

    <Row id="ai-apps" title={topic('ai-apps')} where="Your AI apps">
      <p>You choose which AI apps to connect, and each one is made by another company under its
         own terms and privacy policy. When you connect an app, you allow it to read, search and
         save your memories whenever it decides to, and it can send your memories to its maker
         as part of your conversations. We do not control those apps, what they say or do, or
         what their makers do with your information, and we are not responsible for them. Naming
         an app on our website does not mean its maker endorses Zaaheen or that we endorse the
         app.</p>
      <p>An AI app can be misled by instructions hidden in a web page, email or file it reads,
         and may then save wrong memories or use memories you did not expect. Connect only apps
         you trust, and do not keep passwords, card numbers, recovery codes or anything you would
         not want an AI app to read in Zaaheen. You can disconnect an app at any time.</p>
    </Row>
  </section>

  <section id="legal" class="docs-section">
    <h2 class="docs-title">The legal part</h2>

    <Row id="responsibility" title={topic('responsibility')} where="Our promise">
      <p>We provide Zaaheen with reasonable care and skill. If we break these terms, we are
         responsible for loss you suffer that was a foreseeable result of it.</p>
      <p>As far as the law allows, we are not responsible for:</p>
      <ul>
        <li>losses you could have avoided, such as memories lost with a computer when you kept no
            copy, unless our own lack of care caused the loss;</li>
        <li>what other companies' AI apps do, say or send;</li>
        <li>business losses, such as lost profits or opportunities.</li>
      </ul>
      <p><strong>How much we are responsible for.</strong> As far as the law allows, our total
         responsibility to you for all claims connected with Zaaheen is limited to the greater of
         the total amount you paid for Zaaheen in the 12 months before the event that caused the
         claim, or USD 50.</p>
      <p>This limit is about claims for loss or damage. It is not a refund and gives you no right
         to money back. Refunds are covered by our <a href="/refunds/">Refund Policy</a> and the
         refunds these terms name.</p>
      <p>This limit never reduces your legal right to a repair, a replacement, a price reduction
         or a refund where Zaaheen does not work as described. Nothing in these terms limits
         anything the law doesn't let us limit, such as our responsibility for death or personal
         injury caused by our negligence, or for fraud.</p>
    </Row>

    <Row id="closing" title={topic('closing')} where="Your account">
      <p>You can delete your Zaaheen account at any time on our <a href={ACCOUNT.deleteAccount}><em>Delete my account</em> page</a>,
         by choosing <em>Delete my account</em> in the app, or by emailing us. Deleting your
         account cancels any subscription straight away and ends your access. Time left on your
         plan is not refunded, so if you paid in the last 14 days, ask for your refund under our
         <a href="/refunds/">Refund Policy</a> before you delete the account.</p>
      <p><em>Delete my account</em> in the app deletes the memories on that computer first, and
         offers to download them before it does. The web page deletes only your account and
         leaves the memories on your computers untouched.</p>
      <p>We suspend or close an account only if you seriously or repeatedly break these terms, to
         stop fraud or abuse, to protect our systems or other people from a security threat, or
         because the law requires it. We tell you why, unless the law stops us. Your memories
         stay on your computer and you can still download them.</p>
    </Row>

    <Row id="stopping" title={topic('stopping')} where="60 days' notice">
      <p>If we decide to stop offering Zaaheen, we will tell you at least 60 days before, stop
         taking payments, and refund the unused part of any yearly plan. <em>Download my
         memories</em> keeps working, so you can take everything with you.</p>
    </Row>

    <Row id="changes" title={topic('changes')} where="With notice">
      <p>We keep improving Zaaheen, and features may change as we do. We will never make a change
         that takes your memories from you.</p>
      <p>We change these terms only for one of these reasons: to reflect a change in the law or a
         regulator's guidance, a change in how Zaaheen works or a new feature, a change in the
         services we rely on, or to correct a mistake or make the terms clearer. For a change
         that affects your rights, we email you at least 30 days before it applies, and it
         applies to you from your next renewal after that. If you don't accept it, cancel before
         then. A change that only makes the terms clearer or adds a feature can apply straight
         away.</p>
    </Row>

    <Row id="general" title={topic('general')} where="The small print">
      <p><strong>Events outside our control.</strong> We are not responsible for a delay or
         failure caused by events outside our reasonable control, such as a failure of the
         internet, power or a service we rely on, a cyber attack we could not reasonably
         prevent, war or government action. We tell you about it and do what we reasonably can to
         limit the effect. If such an event stops our service working for more than 30 days in a
         row, you can cancel and we refund the unused part of your current plan. This does not
         cover problems with your own computer, device or internet connection.</p>
      <p><strong>If part of these terms is invalid.</strong> If a court decides that part of these
         terms cannot be enforced, the rest still applies.</p>
      <p><strong>The whole agreement.</strong> These terms, our Privacy Policy and our Refund
         Policy are the whole agreement between you and us about Zaaheen. Paddle's buyer terms
         separately cover your purchase from Paddle.</p>
      <p><strong>Transferring this agreement.</strong> We may transfer our rights and duties under
         these terms to another business, for example if we become a company or the business is
         sold. We will tell you, and your rights under these terms will not be reduced. You may
         not transfer your account or these terms to anyone else.</p>
      <p><strong>Not enforcing a term straight away.</strong> If we do not insist on something
         straight away, we can still insist on it later.</p>
      <p><strong>Who can enforce these terms.</strong> Only you and we can enforce these
         terms.</p>
      <p><strong>How we contact you.</strong> We send notices to the email address on your
         account, so keep it up to date. You can send notices to <a href={mail}>{COMPANY.email}</a>.</p>
      <p><strong>Language.</strong> These terms are written in English. Where the law where you
         live requires a version in another language, including Arabic for consumers in the
         United Arab Emirates, that version applies to you as far as the law requires, and we
         provide it on request.</p>
    </Row>

    <Row id="websites" title={topic('websites')} where="zaaheen.com">
      <p>You can read and share the pages on our websites for your own, non-commercial use. Do not
         copy large parts of them into another website or product, and do not try to break into,
         overload or disrupt them. Links to other companies' websites are there for convenience,
         and we are not responsible for those websites.</p>
      <p>If you believe something on our websites or in Zaaheen breaks your copyright or other
         rights, email <a href={mail}>{COMPANY.email}</a> with "Rights complaint" in the subject,
         the content concerned and why. We reply within 14 days.</p>
    </Row>

    <Row id="disputes" title={topic('disputes')} where="Dubai">
      <p>If something goes wrong, please email us first at <a href={mail}>{COMPANY.email}</a>. We
         reply within 5 working days. Most problems can be put right quickly.</p>
      <p>These terms are governed by the laws of the United Arab Emirates as applied in the
         Emirate of Dubai, and the courts of Dubai can hear any dispute. If you are a consumer
         living elsewhere, you keep the protection of the laws where you live that cannot be set
         aside by agreement, and you can bring a claim in the courts where you live. You can also
         contact the consumer protection authority where you live. Nothing in these terms
         requires you to use arbitration.</p>
    </Row>

    <Row id="contact" title={topic('contact')} where="Email">
      <p>Questions about these terms: <a href={mail}>{COMPANY.email}</a>.</p>
    </Row>
  </section>
</Policy>
