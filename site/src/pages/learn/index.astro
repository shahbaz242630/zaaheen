---
import Base from '../../layouts/Base.astro';
import { LEARN, LEARN_BUSINESS, pageFor } from '../../data/site';

// The Learn hub (s91): every article, newest last as LEARN lists them. Since
// s129 a second list for businesses: the AI Readiness Assessment's guides
// (LEARN_BUSINESS, English only).
const page = pageFor('/learn/');
const articles = LEARN.map((a) => ({ ...a, heading: pageFor(a.path).heading }));
const business = LEARN_BUSINESS.map((a) => ({ ...a, heading: pageFor(a.path).heading }));
---
<Base page={page}>
  <div class="docs learn">
    <header class="docs-head">
      <h1>Learn about AI memory</h1>
      <p class="learn-lede">Plain answers to the questions people ask about AI apps that remember: how
         Claude, ChatGPT, Claude Code and Cursor keep what they know about you, and how to keep one
         memory across all of them. Written by Zaaheen and checked against each company's own help
         pages.</p>
    </header>
    <ul class="learn-list">
      {articles.map((a) => <li><a href={a.path}>{a.heading}</a><p>{a.summary}</p></li>)}
    </ul>

    {business.length > 0 && (
      <section class="learn-section" aria-labelledby="for-business">
        <h2 id="for-business" class="docs-title">AI for your business</h2>
        <p class="learn-section-lede">Where AI helps a business and where it doesn't, what it costs and
           why so many projects stall. From our <a href="/consulting/">AI Readiness Assessment</a>.</p>
        <ul class="learn-list">
          {business.map((a) => <li><a href={a.path}>{a.heading}</a><p>{a.summary}</p></li>)}
        </ul>
      </section>
    )}
  </div>
</Base>
