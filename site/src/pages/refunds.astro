---
import Policy, { type Outline } from '../layouts/Policy.astro';
import Row from '../components/Row.astro';
import { COMPANY, PLANS, SITE, TRIAL } from '../data/site';

// The Refund Policy (founder, session 67: "they only refund the last months or
// one months subscription paid. so we adopt the same", settled as the latest
// payment in full within 14 days of the charge, on both plans). 14 days
// matches the withdrawal right in Paddle's buyer terms, so this page never
// offers less than Paddle does. Session 69 (LEGAL-DOCUMENTS-DESIGN.md L2,
// founder: "we are not exploited"): one refund per person, no part refunds,
// abuse, bank reversals, app-only scope, and the legal exception.
const OUTLINE: Outline[] = [
  { id: 'refunds', title: 'Refunds', topics: [
    { id: 'the-rule', title: 'What we refund' },
    { id: 'limits', title: 'What we do not refund' },
    { id: 'how', title: 'How to ask for a refund' },
    { id: 'after', title: 'What happens after a refund' },
  ] },
  { id: 'cancelling', title: 'Cancelling', topics: [
    { id: 'cancel', title: 'How to cancel' },
    { id: 'trial', title: 'The free trial' },
  ] },
  { id: 'rights', title: 'Your rights', topics: [
    { id: 'law', title: 'Your legal rights' },
    { id: 'contact', title: 'Contact us' },
  ] },
];
const topic = (id: string) =>
  OUTLINE.flatMap((s) => s.topics).find((t) => t.id === id)?.title ?? id;
const mail = `mailto:${COMPANY.email}`;
const lede = `${SITE.name} starts with a ${TRIAL.days}-day free trial with no card, so you can be sure before you pay. If you change your mind after paying, here is how refunds work.`;
---
<Policy path="/refunds/" heading="Refund Policy" lede={lede} outline={OUTLINE}>
  <ul slot="summary">
    <li>Ask within 14 days of a payment and we refund that payment in full, on the monthly or the
        yearly plan.</li>
    <li>We refund your latest payment only, not earlier ones, and one payment per person.</li>
    <li>After 14 days there is no refund, except where the law gives you one, but you can
        cancel at any time and keep access until the end of the time you've paid for.</li>
    <li>This policy covers the Zaaheen app only. Coaching has its own cancellation rules.</li>
    <li>Your memories are never affected. They stay on your computer either way.</li>
  </ul>

  <section id="refunds" class="docs-section">
    <h2 class="docs-title">Refunds</h2>

    <Row id="the-rule" title={topic('the-rule')} where="Within 14 days">
      <p>If you ask within 14 days of being charged, we refund that payment in full. This works
         the same on both plans: on {PLANS.monthly} it is that month's payment, and on
         {PLANS.yearly} it is the whole year's.</p>
      <p>We refund your latest payment only, not payments from earlier months or years. After 14
         days we do not refund a payment, except where the law gives you a right to one, but
         cancelling means you won't be charged again.</p>
      <p>This policy covers the Zaaheen app only. Coaching sessions have their own cancellation
         and refund rules, which you see before you book.</p>
    </Row>

    <Row id="limits" title={topic('limits')} where="Fair for everyone">
      <p><strong>One refund per person.</strong> We refund one payment per person. If you have had
         a refund before, on this account or another one, later payments are not refundable,
         except where the law gives you a right to a refund.</p>
      <p><strong>No part refunds.</strong> When you cancel, you keep access until the end of the
         time you paid for. We do not refund the unused part of a month or a year, except where
         our <a href="/terms/">Terms of Service</a> say so, for example if we stop offering
         Zaaheen.</p>
      <p><strong>Using refunds to avoid paying.</strong> We refuse a refund when it is being used
         to get Zaaheen without paying, such as repeated sign-ups and refunds across
         accounts.</p>
      <p><strong>Bank reversals.</strong> If you ask your bank to reverse a payment, your
         subscription ends when the reversal is made. Please email us first: a refund is
         quicker.</p>
      <p><strong>Deleting your account.</strong> Deleting your account cancels your subscription
         with no refund of the time left. If you paid in the last 14 days and want your money
         back, ask for the refund before you delete the account.</p>
    </Row>

    <Row id="how" title={topic('how')} where="Email">
      <p>Email <a href={mail}>{COMPANY.email}</a> from the address on your Zaaheen account and
         say you'd like a refund. We reply within 5 working days, confirm the refund and instruct
         Paddle to send it. You can also ask Paddle directly using the link in your receipt email;
         if Paddle declines a refund this policy gives you, email us and we will instruct it
         ourselves.</p>
      <p>For the Zaaheen app and your subscription: Our order process is conducted by our online
         reseller Paddle.com. Paddle.com is the Merchant of Record for all our orders. Paddle
         provides all customer service inquiries and handles returns. So Paddle sends your
         refund, back to the card or account you paid with. Your bank may take a few days to
         show it.</p>
    </Row>

    <Row id="after" title={topic('after')} where="Nothing is deleted">
      <p>A refund ends that subscription. Zaaheen then stops serving your AI apps until you
         subscribe again, but nothing is deleted: your memories stay on your computer, and
         <em>Download my memories</em> keeps working.</p>
    </Row>
  </section>

  <section id="cancelling" class="docs-section">
    <h2 class="docs-title">Cancelling</h2>

    <Row id="cancel" title={topic('cancel')} where="Settings › Account">
      <p>In the app: <em>Settings › Account › Cancel subscription</em>. On the website:
         <em>Account</em>, then <em>Cancel subscription</em>. Or use the cancel link in any email
         from Paddle, our reseller, which works from any device. Cancelling stops the next
         renewal, and you keep access until the end of the month or year you've paid for.</p>
    </Row>

    <Row id="trial" title={topic('trial')} where="No card needed">
      <p>The {TRIAL.days}-day trial is free and takes no card, so there is nothing to cancel or
         refund. When it ends, Zaaheen asks you to subscribe.</p>
    </Row>
  </section>

  <section id="rights" class="docs-section">
    <h2 class="docs-title">Your rights</h2>

    <Row id="law" title={topic('law')} where="Everyone">
      <p>This policy doesn't take away any right the law gives you where you live. If you live in
         the United Kingdom or the European Union, the law gives you 14 days from a purchase to
         cancel it, and our 14-day refund gives you at least that. If Zaaheen doesn't work as
         described, you are entitled to a repair, a replacement or a refund where the law says
         so, whatever this page says, and we honour that.</p>
    </Row>

    <Row id="contact" title={topic('contact')} where="Email">
      <p>Questions about a payment or a refund: <a href={mail}>{COMPANY.email}</a>.</p>
    </Row>
  </section>
</Policy>
