---
// How to subscribe in French (ADR-113). The plan buttons keep the app's own
// English words ("$5 a month"), as the app and the Account page show them.
import Guide from '../../../layouts/Guide.astro';
import Row from '../../../components/Row.astro';
import Download from '../../../components/Download.astro';
import { ACCOUNT, PLANS, PRICES, TRIAL } from '../../../data/site';
import { localize } from '../../../i18n/locales';

const L = (href: string) => localize(href, 'fr');
const yearlyButton = `${PLANS.yearly} (save $${PRICES.monthly * 12 - PRICES.yearly})`;
const monthly = `${PRICES.monthly} USD par mois`;
const yearly = `${PRICES.yearly} USD par an`;
const OUTLINE = [
  { id: 'account', title: '1. Créez votre compte' },
  { id: 'download', title: '2. Téléchargez Zaaheen' },
  { id: 'trial', title: '3. Connectez-vous depuis l’application' },
  { id: 'in-the-app', title: '4. Abonnez-vous dans l’application' },
  { id: 'on-the-website', title: 'Ou abonnez-vous sur le site web' },
  { id: 'manage', title: 'Changer ou résilier votre formule' },
];
---
<Guide
  path="/fr/docs/subscribe/"
  lede={`Créez votre compte, téléchargez Zaaheen et connectez-vous depuis l’application : votre essai gratuit de ${TRIAL.days} jours commence, sans carte. Abonnez-vous quand vous êtes prêt, pour ${monthly} ou ${yearly}, dans l’application ou sur votre page Account. Un seul abonnement couvre votre compte sur chaque ordinateur où vous vous connectez.`}
  outline={OUTLINE}
>
  <section class="docs-section">
    <Row level={2} id="account" title="1. Créez votre compte" where="Votre navigateur">
      <p><a href={ACCOUNT.signUp}>Créez votre compte Zaaheen</a> avec votre e-mail ou Google. Nous envoyons
         un code à votre adresse e-mail pour confirmer que c’est bien vous. Vous avez déjà un compte ?
         <a href={ACCOUNT.signIn}>Connectez-vous</a>.</p>
    </Row>

    <Row level={2} id="download" title="2. Téléchargez Zaaheen" where="Windows ou Mac">
      <p>Téléchargez l’application pour votre ordinateur et installez-la. Le guide <a
         href={L('/docs/getting-started/')}>Bien démarrer</a> détaille l’installation.</p>
      <Download small />
    </Row>

    <Row level={2} id="trial" title="3. Connectez-vous depuis l’application" where="Zaaheen">
      <p>Ouvrez Zaaheen et choisissez <em>Begin set up</em>, puis connectez-vous avec la même adresse e-mail
         ou le même compte Google. Votre essai gratuit de {TRIAL.days} jours commence la première fois que
         vous vous connectez depuis l’application. Aucune carte n’est demandée, et tout fonctionne pendant
         l’essai.</p>
    </Row>

    <Row level={2} id="in-the-app" title="4. Abonnez-vous dans l’application" where="Settings › Account">
      <p>Abonnez-vous quand vous voulez, pendant votre essai ou après :</p>
      <ol>
        <li>Dans Zaaheen, ouvrez <strong>Settings</strong>, puis <strong>Account</strong>.</li>
        <li>Sous <strong>Subscribe</strong>, choisissez <strong>{PLANS.monthly}</strong> ou
            <strong>{yearlyButton}</strong>.</li>
        <li>Le paiement s’ouvre dans votre navigateur, sur notre page de paiement sécurisée. Les taxes sont
            ajoutées au moment du paiement lorsqu’elles s’appliquent.</li>
        <li>Terminez le paiement dans votre navigateur, puis revenez dans Zaaheen. Il vérifie lui-même votre
            paiement et affiche votre formule comme active dès que le paiement arrive, en général en moins
            d’une minute. Vous pouvez aussi choisir <em>I've paid</em> pour vérifier tout de suite.</li>
      </ol>
      <p>Pendant les sept derniers jours de votre essai, l’écran d’accueil affiche aussi un bouton
         <em>Subscribe</em>. Si votre essai se termine avant, rien n’est supprimé : Zaaheen vous propose de
         vous abonner, et vos souvenirs sont toujours là, sur votre ordinateur.</p>
    </Row>

    <Row level={2} id="on-the-website" title="Ou abonnez-vous sur le site web" where="Page Account">
      <p>Vous préférez payer d’abord ? Ouvrez votre <a href={ACCOUNT.page}>page Account</a>, connectez-vous,
         et sous <strong>Subscribe</strong> choisissez <strong>{PLANS.monthly}</strong> ou
         <strong>{yearlyButton}</strong>. Le paiement s’ouvre sur la même page de paiement sécurisée. Votre
         abonnement est lié à votre compte : l’application le retrouve quand vous vous connectez avec la même
         adresse e-mail.</p>
    </Row>

    <Row level={2} id="manage" title="Changer ou résilier votre formule" where="Application ou page Account">
      <p>Utilisez <strong>Manage subscription</strong> pour changer de formule ou mettre à jour votre carte,
         et <strong>Cancel subscription</strong> pour l’arrêter. Les deux se trouvent dans l’application, sous
         Settings, Account, et sur votre <a href={ACCOUNT.page}>page Account</a>. Après une résiliation,
         Zaaheen continue de fonctionner jusqu’à la fin de la période payée. Pour les remboursements, voir la
         <a href="/refunds/">Politique de remboursement (en anglais)</a>.</p>
    </Row>
  </section>
</Guide>
