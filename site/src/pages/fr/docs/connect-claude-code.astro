---
// The Claude Code connect guide in French (ADR-113). The steps come from the
// desktop app's own wording, translated in src/i18n/ui/fr.ts.
import Guide from '../../../layouts/Guide.astro';
import Row from '../../../components/Row.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'Claude Code';
const OUTLINE = [
  ...connectOutline(NAME).map((o) => ({ ...o, title: t('fr', o.title) })),
  { id: 'using', title: 'L’utiliser' },
];
---
<Guide
  path="/fr/docs/connect-claude-code/"
  lede="Dans un terminal, exécutez une seule commande, affichée dans l’onglet Agents de Zaaheen. Zaaheen est ensuite disponible dans tous vos projets Claude Code."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Terminal" />

    <Row level={2} id="using" title="L’utiliser" where="Claude Code">
      <p>Posez à Claude Code des questions sur vous, vos préférences ou votre travail, ou demandez-lui de
         consulter votre mémoire Zaaheen. Ce qu’il y enregistre, vos autres applications d’IA connectées
         peuvent aussi l’utiliser.</p>
    </Row>
  </section>
</Guide>
