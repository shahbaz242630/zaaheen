---
// The Cursor Desktop connect guide in French (ADR-113). The steps come from the desktop
// app's own wording, translated in src/i18n/ui/fr.ts.
import Guide from '../../../layouts/Guide.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'Cursor Desktop';
const OUTLINE = connectOutline(NAME).map((o) => ({ ...o, title: t('fr', o.title) }));
---
<Guide
  path="/fr/docs/connect-cursor/"
  lede="Dans Zaaheen, ouvrez l’onglet Agents, choisissez Connect an app, puis Cursor Desktop et Connect it for me. Cursor s’ouvre et vous demande d’installer Zaaheen, ce qui peut prendre jusqu’à une minute : cliquez sur Install. L’IDE Cursor utilise ensuite la même connexion."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Cursor › Customize" />
  </section>
</Guide>
