---
// The Antigravity connect guide in German (ADR-113). The steps come from the desktop
// app's own wording, translated in src/i18n/ui/de.ts.
import Guide from '../../../layouts/Guide.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'Antigravity';
const OUTLINE = connectOutline(NAME).map((o) => ({ ...o, title: t('de', o.title) }));
---
<Guide
  path="/de/docs/connect-antigravity/"
  lede="Öffne die Einstellungsdatei von Antigravity, mcp_config.json, füge die Einstellung aus dem Tab Agents in Zaaheen ein, speichere und starte Antigravity neu. Prüf dann, ob Zaaheen unter den MCP-Tools mit einem grünen Kreis erscheint."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Antigravity › mcp_config.json" />
  </section>
</Guide>
