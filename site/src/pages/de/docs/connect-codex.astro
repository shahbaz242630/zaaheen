---
// The Codex connect guide in German (ADR-113). The steps come from the desktop
// app's own wording, translated in src/i18n/ui/de.ts.
import Guide from '../../../layouts/Guide.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'Codex';
const OUTLINE = connectOutline(NAME).map((o) => ({ ...o, title: t('de', o.title) }));
---
<Guide
  path="/de/docs/connect-codex/"
  lede="Füge die Einstellung von Zaaheen zur config.toml von Codex hinzu (der Tab Agents in Zaaheen zeigt sie für deinen Computer), starte Codex neu und prüfe, ob /mcp zaaheen als verbunden anzeigt. ChatGPT Desktop schon verbunden? Codex teilt dessen Einstellungen, also prüf nur, ob es verbunden ist."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Codex › config.toml" />
  </section>
</Guide>
