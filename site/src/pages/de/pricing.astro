---
import Base from '../../layouts/Base.astro';
import { PRICES, RELEASE, TRIAL, VERIFIED_APPS, pageFor, verifiedAppList } from '../../data/site';
import { CHECKED_ON, COMPARISON, COMPARISON_SOURCES } from '../../data/pricing';
import { COMPARE_PAGES } from '../../data/site';
import { localize } from '../../i18n/locales';
import { formatDate } from '../../i18n/ui';

// Pricing in German (ADR-113): the English page's structure with its words
// translated. The comparison rows and the FAQ are English data
// (src/data/pricing.ts), so their German is written here, row for row; the
// facts, prices and sources are the same.
const page = pageFor('/de/pricing/');
const L = (href: string) => localize(href, 'de');
const saving = PRICES.monthly * 12 - PRICES.yearly;
const monthly = `${PRICES.monthly} USD pro Monat`;
const yearly = `${PRICES.yearly} USD pro Jahr`;
const checkedOn = formatDate(CHECKED_ON, 'de');
const apps = verifiedAppList().replace(/ and /, ' und ');
const appsThen = VERIFIED_APPS.join(', ');

const INCLUDED = [
  'So viele Erinnerungen, wie du willst, gespeichert und verschlüsselt auf deinem eigenen Computer',
  'Jede KI-App, die du verbindest: Claude, ChatGPT, Cursor und mehr',
  'Aufräumen auf deinem Computer, täglich oder wöchentlich, wann du willst',
  'Download my memories jederzeit, auch nachdem du nicht mehr zahlst',
  'Alles in einem Schritt löschen, endgültig',
  'Hilfe per E-Mail von den Leuten, die Zaaheen bauen',
];

// The comparison table, in German, keyed by the English row's name (the rows
// and their order come from COMPARISON). Other companies' own words stay in
// quotes, as they wrote them.
const ROWS: Record<string, { kind: string; price: string; where: string; encrypted: string; training: string; apps: string }> = {
  Zaaheen: {
    kind: 'Gedächtnis für alle deine KI-Apps',
    price: `${monthly} oder ${yearly}. ${TRIAL.days} Tage kostenlos, ohne Karte`,
    where: 'Dein Computer',
    encrypted: 'Ja, auf deinem Computer. Unsere Server bekommen deine Erinnerungen nie',
    training: 'Nein',
    apps: `Ja: ${appsThen} und andere Apps, die MCP unterstützen`,
  },
  MemoryPlugin: {
    kind: 'Core-Tarif',
    price: '15 USD pro Monat oder 89 USD pro Jahr',
    where: 'Deren Server',
    encrypted: 'Ja, bei der Übertragung und gespeichert, nicht Ende-zu-Ende',
    training: 'Nein',
    apps: 'Ja: "21+ AI tools"',
  },
  Pieces: {
    kind: 'Pro-Tarif',
    price: '18,99 USD pro Monat',
    where: 'Dein Computer',
    encrypted: 'Keine Angabe',
    training: 'Nein',
    apps: 'Ja: "every MCP-ready AI tool"',
  },
  Mem: {
    kind: 'KI-Notiz-App, Plus-Tarif',
    price: '9 USD pro Monat (kostenloser Tarif verfügbar)',
    where: 'Deren Server',
    encrypted: 'Ja, gespeichert und bei der Übertragung, nicht Ende-zu-Ende',
    training: 'Nein',
    apps: 'Ja, über den eigenen Connector von Mem',
  },
  Obsidian: {
    kind: 'Notiz-App',
    price: 'App kostenlos. Sync 5 USD pro Monat oder 48 USD pro Jahr',
    where: 'Dein Computer. Sync kopiert Notizen auf deren Server',
    encrypted: 'Sync: ja, Ende-zu-Ende',
    training: 'Keine Angabe',
    apps: 'Nur über Plugins aus der Community',
  },
  'ChatGPT memory': {
    kind: 'In ChatGPT eingebaut',
    price: 'Inklusive; der kostenlose Tarif hat "limited memory"',
    where: 'Deren Server',
    encrypted: 'Ja, gespeichert und bei der Übertragung',
    training: 'Ja, außer du schaltest es aus',
    apps: 'In ChatGPT eingebaut',
  },
  'Claude memory': {
    kind: 'In Claude eingebaut',
    price: 'Inklusive, auch im kostenlosen Tarif',
    where: 'Deren Server',
    encrypted: 'Ja, gespeichert und bei der Übertragung',
    training: 'Nur wenn du es erlaubst',
    apps: 'In Claude eingebaut',
  },
};
const NAMES: Record<string, string> = {
  'ChatGPT memory': 'ChatGPT-Gedächtnis',
  'Claude memory': 'Claude-Gedächtnis',
  'Claude pricing': 'Claude-Preise',
  'Claude training policy': 'Claude-Richtlinie zum Training',
};
const COMPARISON_DE = COMPARISON.map((c) => {
  const row = ROWS[c.name];
  if (!row) throw new Error(`de/pricing: no German row for ${c.name}`);
  return { name: NAMES[c.name] ?? c.name, ...row };
});
const SOURCES_DE = COMPARISON_SOURCES.map((s) => ({ url: s.url, name: NAMES[s.name] ?? s.name }));
const COMPARE_LABELS: Record<string, string> = {
  '/learn/ai-memory-apps-compared/': 'KI-Gedächtnis-Apps im Vergleich',
  '/learn/chatgpt-memory-vs-claude-memory/': 'ChatGPT-Gedächtnis vs. Claude-Gedächtnis',
  '/learn/best-memory-mcp-server-for-claude-code/': 'Gedächtnis-Server für Claude Code',
};
const COMPARE_DE = COMPARE_PAGES.map((c) => ({ path: L(c.path), label: COMPARE_LABELS[c.path] ?? c.label }));

const PRICING_FAQ: { q: string; a: string; link?: { href: string; text: string } }[] = [
  {
    q: 'Was ist Zaaheen?',
    a: `Zaaheen ist ein privates Gedächtnis für deine KI-Apps. Es läuft auf deinem Windows-PC oder Mac und gibt ${appsThen} und anderen KI-Apps ein gemeinsames Gedächtnis über dich, damit du dich nicht ständig wiederholen musst. Deine Erinnerungen bleiben verschlüsselt auf deinem eigenen Computer.`,
  },
  {
    q: 'Was kostet Zaaheen?',
    a: `Zaaheen kostet ${monthly} oder ${yearly}, zuzüglich Mehrwertsteuer bzw. US-Sales-Tax, wo sie anfällt. Beide Tarife enthalten alles. Du startest mit einer kostenlosen Testphase von ${TRIAL.days} Tagen.`,
  },
  {
    q: 'Brauche ich für die kostenlose Testphase von Zaaheen eine Karte?',
    a: `Nein. Die Testphase von ${TRIAL.days} Tagen braucht keine Karte, also wird am Ende nichts abgebucht. Zaaheen bittet dich dann einfach, ein Abo abzuschließen.`,
  },
  {
    q: 'ChatGPT und Claude haben schon ein Gedächtnis. Wozu brauche ich Zaaheen?',
    a: 'Das eingebaute Gedächtnis jeder App gehört zu dieser App. Was ChatGPT über dich lernt, bleibt bei ChatGPT, und was Claude lernt, bleibt bei Claude. Zaaheen ist ein Gedächtnis, das alle deine verbundenen KI-Apps teilen: Speichere etwas in Claude, und Cursor oder ChatGPT können es auch nutzen. Das eigene Gedächtnis jeder App kannst du daneben weiter nutzen.',
  },
  {
    q: 'Können ChatGPT und Claude dasselbe Gedächtnis teilen?',
    a: 'Ja, mit Zaaheen. Verbinde beide Apps mit Zaaheen, dann lesen und speichern sie im selben Gedächtnis auf deinem Computer.',
    link: { href: L('/learn/share-memory-between-chatgpt-and-claude/'), text: 'So teilen ChatGPT und Claude ein Gedächtnis' },
  },
  {
    q: 'Was unterscheidet Zaaheen von MemoryPlugin, Pieces, Mem oder Supermemory?',
    a: `Zaaheen speichert deine Erinnerungen verschlüsselt auf deinem eigenen Computer, und unsere Server bekommen sie nie. MemoryPlugin und Mem speichern deine auf ihren Servern. Pieces speichert Erinnerungen ebenfalls auf deinem Computer; sein Pro-Tarif kostet 18,99 USD pro Monat, und die Testphase braucht eine Karte. Zaaheen kostet weniger als MemoryPlugin Core oder Pieces Pro, und seine Testphase braucht keine Karte. Der kostenpflichtige Tarif von Supermemory richtet sich an Entwickler, die mit KI-Gedächtnis bauen, deshalb steht er nicht in der Tabelle. Die Tabelle oben zeigt die Details der anderen, geprüft am ${checkedOn} auf der Website der jeweiligen Firma.`,
    link: { href: L('/learn/ai-memory-apps-compared/'), text: 'KI-Gedächtnis-Apps im Vergleich' },
  },
  {
    q: 'Ist Zaaheen wie Obsidian?',
    a: 'Obsidian ist eine Notiz-App: Du schreibst und ordnest Notizen selbst, und KI-Apps kommen nur über Plugins aus der Community an sie heran. Zaaheen ist für deine KI-Apps gebaut: Sie speichern, was sie über dich lernen, und finden es selbst wieder, in jeder App, die du verbindest. Beide behalten deine Daten auf deinem eigenen Computer.',
  },
  {
    q: 'Nutzt Zaaheen meine Erinnerungen, um KI zu trainieren?',
    a: 'Nein. Zaaheen bekommt deine Erinnerungen nie, also kann es damit auch nichts trainieren. Die KI-Apps, die du verbindest, haben eigene Einstellungen zum Training, die du in jeder App selbst festlegst.',
  },
  {
    q: 'Kann das Zaaheen-Team meine Erinnerungen lesen?',
    a: 'Nein. Deine Erinnerungen werden auf deinem eigenen Computer gespeichert und verschlüsselt, und der Schlüssel bleibt auch dort. Zaaheen lädt sie nie hoch, also haben wir keine Kopie, die wir lesen könnten. Die KI-Apps, die du verbindest, können Erinnerungen als Teil deiner Unterhaltungen an ihre Hersteller senden, nach deren eigenen Datenschutzregeln.',
  },
  {
    q: 'Welche KI-Apps funktionieren mit Zaaheen?',
    a: `Wir haben Zaaheen mit ${apps} getestet. Es funktioniert auch mit anderen KI-Apps, die MCP unterstützen, den üblichen Weg, über den KI-Apps sich mit Tools verbinden. Die Zaaheen-App zeigt dir, wie du jede einzelne verbindest.`,
  },
  {
    q: 'Nutzen meine KI-Apps Zaaheen wirklich?',
    a: 'Manche Apps, etwa Cursor, schauen von selbst in Zaaheen nach, wenn du etwas über dich fragst. Andere, etwa Claude und ChatGPT, schauen oft zuerst in ihr eigenes Gedächtnis. Deshalb gibt dir die Zaaheen-App für sie einen Tipp in einer Zeile, damit sie auch in Zaaheen nachsehen.',
  },
  {
    q: 'Kann ich meine bisherigen Erinnerungen aus ChatGPT oder Claude in Zaaheen übernehmen?',
    a: 'Einen Import mit einem Klick gibt es noch nicht. Sobald eine App verbunden ist, kannst du sie bitten, das Wichtige in Zaaheen zu speichern, und jede andere verbundene App kann es dann nutzen.',
    link: { href: L('/learn/switch-from-chatgpt-to-claude/'), text: 'Von ChatGPT zu Claude wechseln, ohne von vorn anzufangen' },
  },
  {
    q: 'Funktioniert Zaaheen auf dem Mac oder auf meinem Handy?',
    a: 'Auf dem Mac ja: Zaaheen läuft auf Macs mit Apple-Chip (M1 oder neuer), getestet unter macOS 26. Es läuft auch unter Windows, getestet unter Windows 11. Eine Handy-App gibt es noch nicht.',
  },
  {
    q: 'Kann ich Zaaheen jederzeit kündigen?',
    a: 'Ja. Kündige in der App unter Settings, dann Account, dann Cancel subscription, und du behältst den Zugang bis zum Ende des bezahlten Zeitraums. Wenn du innerhalb von 14 Tagen nach einer Zahlung fragst, erstatten wir sie vollständig, einmal pro Person.',
  },
  {
    q: 'Was passiert mit meinen Erinnerungen, wenn ich nicht mehr für Zaaheen zahle?',
    a: 'Nichts wird gelöscht. Deine Erinnerungen bleiben auf deinem Computer, und Download my memories funktioniert weiter, also kannst du sie immer mitnehmen. Zaaheen bedient deine KI-Apps erst wieder, wenn du erneut ein Abo abschließt.',
  },
  {
    q: 'Warum nicht einfach eine Textdatei mit Notizen für meine KI?',
    a: 'Eine Notizdatei funktioniert gut für eine App und ein Projekt, und eine Datei wie AGENTS.md ist der richtige Ort für die Regeln eines Projekts. Zaaheen ist für das, was über dich stimmt: Deine KI-Apps speichern unterwegs, was sie über dich lernen, finden die richtige Erinnerung, wenn es darauf ankommt, und teilen sie mit jeder App, die du verbindest.',
    link: { href: L('/learn/ai-memory-tool-or-notes-file/'), text: 'Gedächtnis-Tool oder Notizdatei?' },
  },
];
---
<Base page={page}>
  <div class="pricing">
    <header class="pricing-head">
      <p class="eyebrow">{TRIAL.days} Tage kostenlos, ohne Karte</p>
      <h1>Zaaheen Preise: ein Tarif, alles inklusive.</h1>
      <p class="lede">Zaaheen gibt allen deinen KI-Apps ein privates Gedächtnis, das auf deinem eigenen
         Computer bleibt. Teste es {TRIAL.days} Tage kostenlos und entscheide dann, wie du zahlen möchtest.</p>
    </header>

    <div class="plans">
      <section class="plan" aria-labelledby="plan-monthly">
        <h2 id="plan-monthly">Monatlich</h2>
        <p class="plan-price"><span class="plan-amount">{PRICES.monthly} USD</span> pro Monat</p>
        <p class="plan-tax">Zuzüglich Mehrwertsteuer bzw. US-Sales-Tax, wo sie anfällt.</p>
        <p class="plan-note">Verlängert sich jeden Monat, bis du kündigst.</p>
        {RELEASE.available
          ? <a class="cta" href={L('/docs/subscribe/')}>So schließt du ein Abo ab</a>
          : <span class="cta cta-soon">Bald für Windows und Mac</span>}
      </section>
      <section class="plan plan-best" aria-labelledby="plan-yearly">
        <p class="plan-tag">Spare {saving} USD pro Jahr</p>
        <h2 id="plan-yearly">Jährlich</h2>
        <p class="plan-price"><span class="plan-amount">{PRICES.yearly} USD</span> pro Jahr</p>
        <p class="plan-tax">Zuzüglich Mehrwertsteuer bzw. US-Sales-Tax, wo sie anfällt.</p>
        <p class="plan-note">Verlängert sich jedes Jahr, bis du kündigst.</p>
        {RELEASE.available
          ? <a class="cta" href={L('/docs/subscribe/')}>So schließt du ein Abo ab</a>
          : <span class="cta cta-soon">Bald für Windows und Mac</span>}
      </section>
    </div>

    <section class="pricing-included" aria-labelledby="included">
      <h2 id="included">Das ist in beiden Tarifen enthalten</h2>
      <ul>
        {INCLUDED.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="pricing-compare" aria-labelledby="compare">
      <h2 id="compare">Zaaheen im Vergleich</h2>
      <p class="pricing-compare-lede">Andere KI-Gedächtnis-Produkte und das Gedächtnis, das in die KI-Apps
         selbst eingebaut ist, verglichen in den Punkten, auf die es bei der Wahl ankommt.</p>
      <div class="vs-wrap">
        <table class="vs">
          <thead>
            <tr>
              <th scope="col">Produkt</th>
              <th scope="col">Preis für eine Person</th>
              <th scope="col">Wo deine Erinnerungen liegen</th>
              <th scope="col">Verschlüsselt</th>
              <th scope="col">Zum KI-Training genutzt</th>
              <th scope="col">Funktioniert in deinen KI-Apps</th>
            </tr>
          </thead>
          <tbody>
            {COMPARISON_DE.map((c, i) => (
              <tr class={i === 0 ? 'vs-us' : undefined}>
                <th scope="row">{c.name} <span class="vs-plan">{c.kind}</span></th>
                <td>{c.price}</td>
                <td class="vs-where">{c.where}</td>
                <td>{c.encrypted}</td>
                <td>{c.training}</td>
                <td>{c.apps}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="vs-note">Preise und Funktionen anderer Firmen stammen von deren eigenen Websites und
         Datenschutzseiten, Stand {checkedOn}, in US-Dollar vor Steuern, ihre eigenen Worte in
         Anführungszeichen. "Keine Angabe" heißt, dass die eigenen Seiten der Firma nichts dazu sagen.
         Preise und Richtlinien können sich ändern, also prüfe sie vor dem Kauf:
         {SOURCES_DE.map((src, i) => (
           <>{i > 0 && ', '}<a href={src.url} target="_blank" rel="noopener noreferrer">{src.name}</a></>
         ))}.</p>
      <p class="vs-note">Ausführliche Vergleiche:
         {COMPARE_DE.map((c, i) => (
           <>{i > 0 && ' · '}<a href={c.path}>{c.label}</a></>
         ))}.</p>
    </section>

    <section class="pricing-small" aria-labelledby="small-print">
      <h2 id="small-print">Das Kleingedruckte, in einfachen Worten</h2>
      <ul>
        <li>Deine Testphase von {TRIAL.days} Tagen braucht keine Karte, also wird am Ende nichts
            abgebucht. Zaaheen bittet dich dann einfach, ein Abo abzuschließen.</li>
        <li>Die Preise sind in US-Dollar, zuzüglich Mehrwertsteuer bzw. US-Sales-Tax, wo sie anfällt,
            eingezogen von unserem Wiederverkäufer Paddle. Du siehst den genauen Betrag, bevor du zahlst.</li>
        <li>Dein Tarif verlängert sich automatisch, bis du kündigst. Kündige jederzeit in der App, auf
            deiner <em>Account</em>-Seite auf der Website oder über den Kündigungslink in jeder E-Mail
            von Paddle, und behalte den Zugang bis zum Ende des bezahlten Zeitraums.</li>
        <li>Fragst du innerhalb von 14 Tagen nach einer Zahlung, erstatten wir sie vollständig, einmal pro
            Person. Siehe die <a href="/refunds/">Erstattungsrichtlinie (auf Englisch)</a> und die <a
            href="/terms/">Nutzungsbedingungen (auf Englisch)</a>.</li>
        <li>Zahlungen wickelt Paddle.com ab, unser Wiederverkäufer und Merchant of Record.</li>
      </ul>
    </section>

    <section class="pricing-faq" aria-labelledby="pricing-faq">
      <h2 id="pricing-faq">Fragen zu Zaaheen</h2>
      <div class="faq-list">
        {PRICING_FAQ.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}{f.link && <> <a href={f.link.href}>{f.link.text}</a>.</>}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>
