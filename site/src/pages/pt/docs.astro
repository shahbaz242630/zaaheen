---
// The Documents hub in Brazilian Portuguese (ADR-113): the English page's
// structure with its words translated. Every step names the app's own screens
// and buttons in English, as the app shows them; the section and topic ids
// are the English page's, so anchors keep working.
import Base from '../../layouts/Base.astro';
import DocsNav from '../../components/DocsNav.astro';
import Download from '../../components/Download.astro';
import { ACCOUNT, COMPANY, PRICES, RELEASE, TRIAL, pageFor } from '../../data/site';
import { lastModified } from '../../lib/lastmod';
import { localize } from '../../i18n/locales';
import { formatDate, t } from '../../i18n/ui';

const page = pageFor('/pt/docs/');
const L = (href: string) => localize(href, 'pt');
const win = RELEASE.windows;
const mac = RELEASE.mac;
const monthly = `US$ ${PRICES.monthly} por mês`;
const yearly = `US$ ${PRICES.yearly} por ano`;
const updated = lastModified(page.path);
const updatedLabel = updated ? formatDate(updated, 'pt') : undefined;

const OUTLINE = [
  { id: 'getting-started', title: 'Primeiros passos', topics: [
    { id: 'install', title: 'Como instalar o Zaaheen' },
    { id: 'first-launch', title: 'O que acontece na primeira vez que você abre' },
  ] },
  { id: 'connecting', title: 'Conectar seus apps de IA', topics: [
    { id: 'connect-claude', title: 'Claude Desktop' },
    { id: 'connect-claude-code', title: 'Claude Code' },
    { id: 'connect-cursor', title: 'Cursor' },
    { id: 'connect-chatgpt', title: 'ChatGPT' },
    { id: 'connect-other', title: 'Outros apps de IA' },
  ] },
  { id: 'memories', title: 'Suas memórias', topics: [
    { id: 'location', title: 'Onde suas memórias ficam' },
    { id: 'consolidation', title: 'O que a arrumação faz' },
    { id: 'download', title: 'Como levar suas memórias com você' },
    { id: 'delete', title: 'Como apagar tudo' },
  ] },
  { id: 'account', title: 'Conta e assinatura', topics: [
    { id: 'subscription', title: 'Como funcionam o teste e a assinatura' },
    { id: 'delete-account', title: 'Como excluir sua conta' },
    { id: 'uninstall', title: 'Como desinstalar o Zaaheen' },
  ] },
  { id: 'support', title: 'Ajuda', topics: [
    { id: 'help', title: 'Como conseguir ajuda' },
  ] },
];
const topic = (id: string) =>
  OUTLINE.flatMap((s) => s.topics).find((x) => x.id === id)?.title ?? id;
---
<Base page={page}>
  <div class="docs">
    <header class="docs-head">
      <h1>Ajuda e guias do Zaaheen</h1>
      <p>Como instalar o app de memória Zaaheen, conectar seus apps de IA a ele e cuidar das suas
         memórias. O app está em inglês, então cada passo usa as mesmas palavras em inglês que você vai ver na tela.</p>
      {updatedLabel && <p class="doc-updated">{t('pt', 'Last updated {date}', { date: updatedLabel })}</p>}
    </header>

    <div class="docs-layout">
      <DocsNav current="/pt/docs/" />

      <div class="docs-body">
        <section id="getting-started" class="docs-section">
          <h2 class="docs-title">Primeiros passos</h2>

          <div id="install" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">{topic('install')}</h3>
                <span class="set-where">Windows ou Mac</span>
              </div>
              {!RELEASE.available && <p><strong>O Zaaheen para Windows e Mac chega em breve.</strong> Estes
                 passos mostram como funciona quando você puder baixá-lo.</p>}
              <p>O Zaaheen {RELEASE.version} é para Windows (64 bits,
                 testado no {win.tested}) e para Macs com chip da Apple, M1 ou mais recente (testado no
                 {mac.tested}). Ainda não está disponível para Linux nem para celulares.</p>
              <Download small />
              <p><strong>No Windows,</strong> abra o instalador{RELEASE.available ? ` (${win.size})` : ''}.
                 <strong>No Mac,</strong> abra a imagem de disco{RELEASE.available ? ` (${mac.size})` : ''},
                 arraste o Zaaheen para a pasta Aplicativos (Applications) e abra o app a partir dela. O Windows ou o seu
                 Mac podem fazer uma ou duas perguntas no caminho, e todas são esperadas:
                 <a href={L('/docs/getting-started/#install')}>o que cada pergunta quer dizer e o que escolher</a>.</p>
            </div>
          </div>

          <div id="first-launch" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">{topic('first-launch')}</h3>
                <span class="set-where">Configuração</span>
              </div>
              <p>Escolha <em>Begin set up</em>. A configuração leva cerca de três minutos:</p>
              <ol>
                <li><strong>Sua conta.</strong> Escolha <em>Create an account</em> ou <em>Sign
                    in</em>. Isso abre seu navegador. Seu teste grátis de {TRIAL.days} dias começa na
                    primeira vez que você entra pelo app do Zaaheen, e não precisa de cartão. Entrar na conta
                    nunca compartilha suas memórias conosco.</li>
                <li><strong>Onde guardar suas memórias.</strong> O lugar padrão serve para a maioria das pessoas.
                    Você pode mudar depois.</li>
                <li><strong>Seu primeiro app de IA.</strong> Escolha o app que você usa e siga os passos, ou
                    escolha <em>I'll connect one later</em>.</li>
                <li><strong>Sua primeira memória.</strong> Conte ao Zaaheen algo que seus apps de IA devem saber
                    sobre você e escolha <em>Keep this memory</em>, ou <em>Skip for now</em>.</li>
                <li><strong>Arrumação.</strong> Escolha se o Zaaheen deve arrumar sua memória sozinho
                    todos os dias e depois <em>Finish setup</em>.</li>
              </ol>
              <p>Na primeira vez, o Zaaheen também baixa o que precisa para pesquisar suas memórias. Ele faz
                 isso em segundo plano, e você pode usá-lo enquanto termina.
                 <a href={L('/docs/getting-started/')}>Guia completo: instalar e configurar o Zaaheen</a>.</p>
            </div>
          </div>
        </section>

        <section id="connecting" class="docs-section">
          <h2 class="docs-title">Conectar seus apps de IA</h2>
          <p class="docs-intro">Abra a aba <em>Agents</em> e escolha <em>+ Connect an AI app</em>.
             O Zaaheen nunca muda sozinho as configurações de outro app: ele entrega ao app o que é preciso, e
             o app pergunta a você.</p>

          <div id="connect-claude" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">Claude Desktop (o app do Claude para o seu computador)</h3>
                <span class="set-where">Agents › Connect</span>
              </div>
              <p>Escolha <em>Connect it for me</em>. O Claude pede para você instalar o Zaaheen: clique em
                 <em>Install</em> e pronto, está conectado. Funciona no Chat e no Cowork do Claude.
                 <a href={L('/docs/connect-claude/')}>Guia completo: conectar o Claude Desktop</a>.</p>
            </div>
          </div>

          <div id="connect-claude-code" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">Claude Code (o Claude no seu terminal)</h3>
                <span class="set-where">Terminal</span>
              </div>
              <p>Em um terminal, rode uma vez o comando que aparece na aba <em>Agents</em>. O Zaaheen fica
                 disponível em todos os projetos do Claude Code.
                 <a href={L('/docs/connect-claude-code/')}>Guia completo: conectar o Claude Code</a>.</p>
            </div>
          </div>

          <div id="connect-cursor" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">Cursor</h3>
                <span class="set-where">Agents › Connect</span>
              </div>
              <p>Escolha <em>Connect it for me</em>. O Cursor pede para você instalar o Zaaheen: clique em
                 <em>Install</em> e pronto, está conectado.
                 <a href={L('/docs/connect-cursor/')}>Guia completo: conectar o Cursor</a>.</p>
            </div>
          </div>

          <div id="connect-chatgpt" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">ChatGPT (o app para o seu computador)</h3>
                <span class="set-where">ChatGPT › Settings</span>
              </div>
              <p>No ChatGPT, abra Settings, depois Plugins, depois MCP, e adicione o Zaaheen como servidor
                 MCP. Use-o no modo Work ou Codex do ChatGPT; o modo Chat não consegue se conectar a apps
                 do seu computador. <a href={L('/docs/connect-chatgpt/')}>Guia completo: conectar o ChatGPT</a>.</p>
            </div>
          </div>

          <div id="connect-other" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">Outros apps de IA</h3>
                <span class="set-where">Agents</span>
              </div>
              <p>O Zaaheen se conecta por MCP, o padrão que muitos apps de IA usam. A aba <em>Agents</em>
                 também mostra a configuração para outros apps. Um app aparece nessa aba enquanto está aberto e
                 conectado. <a href={L('/docs/connect-other-apps/')}>Guia completo: conectar outros apps de IA</a>.</p>
            </div>
          </div>
        </section>

        <section id="memories" class="docs-section">
          <h2 class="docs-title">Suas memórias</h2>

          <div id="location" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">{topic('location')}</h3>
                <span class="set-where">Settings › Your memories</span>
              </div>
              <p>No seu próprio computador, criptografadas. Elas nunca são enviadas para a internet. Para guardá-las
                 em outra pasta ou em outra unidade, escolha <em>Move my memories…</em>. O Zaaheen fecha, move
                 as memórias e abre de novo sozinho. Se ele fechar no meio do caminho, suas memórias continuam seguras
                 onde estavam.</p>
            </div>
          </div>

          <div id="consolidation" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">O que a arrumação (consolidation) faz</h3>
                <span class="set-where">Consolidation</span>
              </div>
              <p>Enquanto você está longe, o Zaaheen organiza o que aprendeu: junta quase duplicatas
                 em uma só, resolve fatos que se contradizem a favor do mais recente e arquiva memórias
                 antigas que você nunca usa, tirando-as da consulta do dia a dia. Ele nunca as apaga, e
                 tudo isso acontece no seu computador.</p>
              <p>A configuração inicial ativa a arrumação, todos os dias às 3 da manhã, a menos que você escolha
                 <em>Not now</em>. Você pode mudar ou desativar isso em <em>Consolidation</em>. Se o computador
                 estava em repouso ou desligado nesse horário, ela é feita mais tarde. Para arrumar na hora, escolha
                 <em>Run consolidation now</em>. O Zaaheen baixa o que precisa, cerca de 2,5 GB, uma vez, durante
                 a configuração.</p>
            </div>
          </div>

          <div id="download" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">{topic('download')}</h3>
                <span class="set-where">Settings › Your memories</span>
              </div>
              <p>Escolha <em>Download my memories</em>. Isso salva tudo o que você guardou em um único arquivo.
                 Ele é seu, assinando ou não: o botão continua disponível mesmo depois que um
                 teste ou uma assinatura termina.</p>
            </div>
          </div>

          <div id="delete" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">{topic('delete')}</h3>
                <span class="set-where">Settings › Your memories</span>
              </div>
              <p>Escolha <em>Delete everything</em>, digite DELETE para confirmar e depois escolha
                 <em>Permanently delete everything</em>. Isso destrói a chave de criptografia e os
                 arquivos de memória, então não pode ser desfeito, e nenhuma cópia criptografada pode ser aberta de novo.
                 Arquivos que você salvou com <em>Download my memories</em> são cópias legíveis que não são
                 afetadas, então apague-os você mesmo. Apagar suas memórias não cancela sua
                 assinatura; cancele-a à parte com <em>Cancel subscription</em>.</p>
            </div>
          </div>
        </section>

        <section id="account" class="docs-section">
          <h2 class="docs-title">Conta e assinatura</h2>

          <div id="subscription" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">{topic('subscription')}</h3>
                <span class="set-where">Settings › Account</span>
              </div>
              <p>Os primeiros {TRIAL.days} dias são grátis, sem cartão. Depois disso, custa {monthly}
                 ou {yearly}. Para assinar, escolha <em>Subscribe</em> no app: o pagamento abre
                 no seu navegador, e o Zaaheen se desbloqueia sozinho quando ele é confirmado. Para mudar de
                 plano ou atualizar seu cartão, escolha <em>Manage subscription</em>. Para encerrar, escolha
                 <em>Cancel subscription</em>. As duas opções também estão na sua página <em>Account</em> em
                 zaaheen.com. Ou use o link de cancelamento de qualquer e-mail da Paddle, nossa revendedora, que
                 funciona em qualquer dispositivo.</p>
              <p>Se um teste ou uma assinatura terminar, nada é apagado. Tudo continua no seu
                 computador, e você ainda pode baixar.</p>
            </div>
          </div>

          <div id="delete-account" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">{topic('delete-account')}</h3>
                <span class="set-where">Settings › Account</span>
              </div>
              <p>Escolha <em>Delete my account</em> no app. Ele oferece baixar suas memórias,
                 apaga as memórias deste computador e depois abre uma página onde você confirma a exclusão
                 da sua conta do Zaaheen. Para excluir só a conta e manter suas memórias, use a
                 <a href={ACCOUNT.deleteAccount}>página <em>Delete my account</em></a> do nosso site.</p>
              <p>Excluir sua conta cancela qualquer assinatura na hora, sem reembolso do
                 tempo restante. Se você pagou nos últimos 14 dias, peça seu reembolso antes, de acordo com a nossa
                 <a href="/refunds/">Política de Reembolso (em inglês)</a>.</p>
            </div>
          </div>

          <div id="uninstall" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">{topic('uninstall')}</h3>
                <span class="set-where">Configurações do Windows ou Aplicativos</span>
              </div>
              <p>Remover o app não remove suas memórias, então ao reinstalar ele as encontra de novo.
                 Para remover suas memórias também, use <em>Delete everything</em> antes.</p>
              <p><strong>No Windows,</strong> abra as Configurações do Windows, depois Aplicativos, depois Aplicativos instalados,
                 e desinstale o Zaaheen.</p>
              <p><strong>No Mac,</strong> feche o Zaaheen e arraste-o de Aplicativos para o Lixo.
                 Para liberar o espaço que os motores de IA baixados usam (vários GB), apague também as
                 pastas <code>~/Library/Application Support/com.zaaheen.app</code> e
                 <code>~/Library/Logs/com.zaaheen.app</code>.</p>
            </div>
          </div>
        </section>

        <section id="support" class="docs-section">
          <h2 class="docs-title">Ajuda</h2>

          <div id="help" class="set-row">
            <div class="set-text">
              <div class="set-head">
                <h3 class="set-name">{topic('help')}</h3>
                <span class="set-where">Settings › Help</span>
              </div>
              <p>Escreva para <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>. Se algo deu
                 errado, escolha <em>Save activity record…</em> e anexe o arquivo. O registro não contém
                 nenhuma das suas memórias. Muitos problemas têm uma solução rápida em
                 <a href={L('/docs/troubleshooting/')}>Solução de problemas comuns</a>.</p>
            </div>
          </div>
        </section>
      </div>

      <aside class="docs-toc" aria-label={t('pt', 'On this page')}>
        <p class="docs-toc-title">{t('pt', 'On this page')}</p>
        {OUTLINE.map((s) => (
          <div class="docs-toc-group" data-section={s.id}>
            <a class="docs-toc-section" href={`#${s.id}`}>{s.title}</a>
            <ul>
              {s.topics.map((x) => <li><a href={`#${x.id}`} data-topic={x.id}>{x.title}</a></li>)}
            </ul>
          </div>
        ))}
      </aside>
    </div>
  </div>

  <script src="../../scripts/docs-nav.js"></script>
</Base>
