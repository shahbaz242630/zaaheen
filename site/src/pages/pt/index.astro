---
// The home page in Brazilian Portuguese (ADR-113): the English page's
// structure with its words translated. The pictures of the app (the demo
// window, its buttons) stay in English, as the app shows them. Translated from
// the English page whose fingerprint src/i18n/translated-from.json records.
import Base from '../../layouts/Base.astro';
import Download from '../../components/Download.astro';
import { COMPANY, DEMO_APPS, PICTURED_APPS, PRICES, RELEASE, TRIAL, pageFor, verifiedAppList } from '../../data/site';
import { localize } from '../../i18n/locales';

const page = pageFor('/pt/');
const L = (href: string) => localize(href, 'pt');
const apps = verifiedAppList().replace(/ and /, ' e ');
const monthly = `US$ ${PRICES.monthly} por mês`;
const yearly = `US$ ${PRICES.yearly} por ano`;

const PROMISES = [
  { key: 'local', text: 'Fica no seu computador' },
  { key: 'trial', text: `Teste grátis de ${TRIAL.days} dias, sem cartão` },
  { key: 'delete', text: 'Apague tudo em um só passo' },
];

// The demo window is a picture of the app, which is in English.
const SAID_ONCE_APP = 'Prefers short answers in plain English';
const START = [
  { type: 'fact', text: SAID_ONCE_APP, when: '2 days ago' },
  { type: 'how-to', text: 'Book meetings after 10am, never on Fridays', when: 'last week' },
];
const SAID_ONCE = 'Prefere respostas curtas e em linguagem simples';
const MEMORIES = [
  { type: 'fato', text: SAID_ONCE },
  { type: 'como fazer', text: 'Marcar reuniões depois das 10h, nunca às sextas' },
];

const FAQ: { q: string; a: string; link?: { href: string; text: string } }[] = [
  {
    q: 'O que o Zaaheen faz?',
    a: `O Zaaheen dá aos seus apps de IA uma única memória compartilhada sobre você. Conte algo uma vez ao ${apps}, e todos os apps que você conectar poderão lembrar disso depois. Ele roda no seu PC com Windows ou no seu Mac e guarda suas memórias ali, criptografadas.`,
  },
  {
    q: 'Por que escolher o Zaaheen e não outra ferramenta de memória para IA?',
    a: `O Zaaheen junta três coisas. Suas memórias ficam no seu próprio computador, criptografadas, e nossos servidores nunca as recebem. Uma única memória funciona em todos os seus apps de IA conectados, em vez de uma separada dentro de cada um. E você continua no controle: veja cada memória, esqueça a que quiser, baixe todas ou apague tudo em um só passo. Custa ${monthly} ou ${yearly} depois de um teste grátis de ${TRIAL.days} dias, sem cartão. Nossa página de preços compara o Zaaheen com outras ferramentas de memória, conferido no site de cada empresa.`,
    link: { href: L('/pricing/#compare'), text: 'Compare o Zaaheen com outras ferramentas de memória' },
  },
  {
    q: 'Onde o Zaaheen guarda minhas memórias?',
    a: 'No seu próprio computador, criptografadas, e elas nunca são enviadas para a internet. Você pode movê-las para outra pasta ou unidade em Settings, com Move my memories.',
  },
  {
    q: 'Posso ver e apagar o que meus apps de IA lembram sobre mim?',
    a: 'Sim. Cada memória aparece no app do Zaaheen, onde você pode pesquisá-la ou esquecer a que quiser. Delete everything, em Settings, destrói a chave de criptografia e os arquivos de memória em um só passo.',
  },
  {
    q: 'Preciso de uma conta para usar o Zaaheen?',
    a: `Sim. Você cria uma conta ou entra na primeira vez que abre o app, e esse primeiro login pelo app inicia seu teste grátis de ${TRIAL.days} dias. A conta cuida do login e da sua assinatura. Ela nunca guarda suas memórias.`,
  },
  {
    q: 'Preciso saber o que é MCP?',
    a: `Não. MCP é a forma padrão de os apps de IA se conectarem a ferramentas, e o app do Zaaheen conecta o ${apps} para você. Para outros apps de IA compatíveis com MCP, a página de documentos mostra como fazer.`,
    link: { href: L('/docs/#connecting'), text: 'Como conectar seus apps de IA' },
  },
  {
    q: 'O Claude Code lembra das coisas entre sessões?',
    a: 'O Claude Code guarda anotações de cada projeto em arquivos como CLAUDE.md. Conecte-o ao Zaaheen uma vez, com um único comando, e ele também poderá salvar o que aprende sobre você e seu jeito de trabalhar, e lembrar disso em qualquer sessão futura e em qualquer projeto. Seus outros apps de IA conectados compartilham as mesmas memórias.',
    link: { href: L('/learn/does-claude-code-remember-between-sessions/'), text: 'O Claude Code lembra entre sessões?' },
  },
  {
    q: 'O Cursor lembra de mim entre um chat e outro?',
    a: 'Sim, depois que o Cursor estiver conectado ao Zaaheen. Ele pode salvar o que aprende sobre você enquanto você trabalha e consultar isso em qualquer chat ou projeto depois. O Cursor consulta o Zaaheen sozinho quando você pergunta algo sobre você.',
    link: { href: L('/docs/connect-cursor/'), text: 'Conectar o Cursor' },
  },
  {
    q: 'Posso usar uma única memória no Claude Code, no Cursor e no Codex?',
    a: 'Sim. Conecte cada um deles ao Zaaheen uma vez, e todos vão ler e salvar na mesma memória do seu computador. Uma preferência que você conta ao Claude Code estará lá quando você abrir o Cursor ou o Codex.',
    link: { href: L('/learn/one-memory-across-claude-code-cursor-and-codex/'), text: 'Uma memória para Claude Code, Cursor e Codex' },
  },
  {
    q: 'Como alternar entre o ChatGPT e o Claude sem perder o contexto?',
    a: 'Conecte os dois ao Zaaheen. O que você conta a qualquer um dos apps vai para uma única memória no seu computador, então o outro pode lembrar disso quando você trocar. A memória interna de cada app ainda não pode ser importada com um clique, então peça ao app que você vinha usando para salvar no Zaaheen o que importa.',
    link: { href: L('/learn/share-memory-between-chatgpt-and-claude/'), text: 'Como compartilhar memória entre o ChatGPT e o Claude' },
  },
  {
    q: 'O que é um servidor de memória MCP?',
    a: 'MCP é a forma padrão de os apps de IA se conectarem a ferramentas. Um servidor de memória é uma ferramenta que dá aos apps de IA um lugar para salvar fatos sobre você e consultá-los depois. O Zaaheen é um deles: roda no seu próprio computador e permite que os apps conectados leiam, pesquisem, salvem, corrijam e esqueçam memórias.',
    link: { href: L('/docs/#connecting'), text: 'Como conectar seus apps de IA' },
  },
  {
    q: 'O ChatGPT funciona com o Zaaheen?',
    a: 'Sim, o app do ChatGPT para o seu computador. Adicione o Zaaheen nas configurações do ChatGPT, em Plugins e depois MCP, e use-o em um chat de Work ou de Codex. O modo Chat do ChatGPT, e o ChatGPT em um navegador, não conseguem se conectar a apps do seu computador.',
    link: { href: L('/docs/connect-chatgpt/'), text: 'Conectar o ChatGPT' },
  },
  {
    q: 'O Zaaheen usa IA?',
    a: 'Sim, três modelos de IA pequenos que rodam no seu próprio computador: um entende o significado, outro ordena os resultados e outro faz a arrumação. Depois de baixados, funcionam offline, e suas memórias nunca passam por um serviço de IA online. O Zaaheen entrega aos seus apps de IA as memórias que correspondem, do jeito que estão guardadas, e o app que você está usando escreve a resposta.',
  },
  {
    q: 'O que a arrumação faz?',
    a: 'Ela junta memórias quase duplicadas, resolve fatos que se contradizem a favor do mais recente e tira da consulta do dia a dia as memórias que você nunca usa. Ela nunca apaga uma memória. A configuração inicial a ativa, todos os dias às 3 da manhã, a menos que você escolha Not now, e você pode mudar ou desativar isso em Consolidation. O que ela precisa, cerca de 2,5 GB, é baixado uma vez durante a configuração.',
  },
  {
    q: 'Quem faz o Zaaheen?',
    a: `O Zaaheen é feito pela ${COMPANY.legalName}, uma empresa licenciada em Dubai. Criamos software para pessoas que usam IA todos os dias, e esta memória privada para seus apps de IA é nosso primeiro produto. Você pode nos escrever em ${COMPANY.email}.`,
  },
];
---
<Base page={page}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Uma memória privada para seus apps de IA</p>
      <h1>Uma única memória para todos os seus apps de IA.</h1>
      <p class="lede">Conte algo uma vez a um app de IA, e todos os apps que você conectar vão lembrar.
         Suas memórias ficam guardadas com segurança no seu próprio computador, criptografadas, e você decide
         quais apps podem lê-las.</p>
      <div class="cta-row">
        <Download />
        <span class="cta-meta">Versão {RELEASE.version}</span>
      </div>
      <p class="cta-note">Para {RELEASE.windows.tested} (64 bits), ou um Mac com chip da Apple (M1 ou
         mais recente). {TRIAL.days} dias grátis, depois {monthly}. <a href={L('/pricing/')}>Ver preços</a></p>
      <p class="cta-note">O app está em inglês.</p>
    </div>

    <!-- A picture of the app, animated by scripts/hero.js. Decorative and in
         English, as the app is; every claim it makes is also in the text. -->
    <div class="demo" id="hero-demo" data-apps={DEMO_APPS.join(',')}>
      <div class="win" aria-hidden="true">
        <div class="win-bar">
          <span class="win-dot"></span><span class="win-dot"></span><span class="win-dot"></span>
          <span class="win-title" id="demo-title">Zaaheen · Memories</span>
        </div>
        <div class="win-body">
          <div class="win-side" id="demo-tabs">
            <div class="win-tab is-on" data-tab="Memories">Memories</div>
            <div class="win-tab" data-tab="Agents">Agents</div>
            <div class="win-tab" data-tab="Consolidation">Consolidation</div>
            <div class="win-tab" data-tab="Settings">Settings</div>
          </div>
          <div class="win-pane" id="demo-pane">
            <div class="pane">
              <div class="pane-title">Recently remembered</div>
              {START.map((m) => (
                <div class="mrow">
                  <span class="mrow-ty">{m.type}</span>
                  <span class="mrow-tx">{m.text}</span>
                  <span class="mrow-wh">{m.when}</span>
                </div>
              ))}
              <div class="pane-foot"><span class="mono-note">2 memories · encrypted on this computer</span></div>
            </div>
          </div>
        </div>
      </div>
      <ul class="demo-chips">
        {PROMISES.map((p) => (
          <li class="demo-chip" data-promise={p.key}><span class="chip-dot"></span>{p.text}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="problem">
    <div class="wrap">
      <div class="section-head is-centred">
        <p class="eyebrow">O problema</p>
        <h2>Todo app de IA começa do zero. Você acaba se explicando de novo.</h2>
      </div>
      <div class="compare">
        <div class="compare-card is-before">
          <div class="compare-head">
            <h3>Sem o Zaaheen</h3>
            <span class="mono-note">{PICTURED_APPS.length} apps · {PICTURED_APPS.length} memórias separadas</span>
          </div>
          <div class="app-trio">
            {PICTURED_APPS.map((a) => (
              <div class="app-card">
                <div class="app-name">{a}</div>
                <div class="app-quote">"Prefiro respostas curtas e em linguagem simples…"</div>
              </div>
            ))}
          </div>
          <p class="compare-note">Cada app guarda as próprias anotações sobre você, em um lugar que você não vê,
             e eles não conversam entre si.</p>
        </div>
        <div class="compare-card is-after">
          <div class="compare-head">
            <h3>Com o Zaaheen</h3>
            <span class="mono-note is-sage">{PICTURED_APPS.length} apps · 1 memória</span>
          </div>
          <div class="shared">
            <div class="app-trio">
              {PICTURED_APPS.map((a) => <div class="app-tile">{a}</div>)}
            </div>
            <div class="shared-line"></div>
            <div class="shared-memory">
              <div class="shared-text">{SAID_ONCE}</div>
              <div class="mono-note is-sage">uma memória · no seu computador</div>
            </div>
          </div>
          <p class="compare-note">Diga uma vez. Todos os apps que você conectar leem a mesma memória,
             guardada no seu próprio computador.</p>
        </div>
      </div>
    </div>
    <div class="strip">
      <div class="strip-row">
        <div class="strip-item">
          <h3>Fica no seu computador</h3>
          <p>Guardada e criptografada no seu dispositivo, nunca enviada para a internet.
             <a href="/ai-and-your-data/">O que podemos e não podemos ver (em inglês)</a></p>
        </div>
        <div class="strip-item">
          <h3>Seus apps de IA compartilham a memória</h3>
          <p>Conecte o {apps} uma vez. Outros apps compatíveis com MCP devem funcionar do mesmo jeito.
             <a href={L('/docs/#connecting')}>Como conectar cada app</a></p>
        </div>
        <div class="strip-item">
          <h3>Você pode apagar tudo</h3>
          <p>Um botão destrói a chave de criptografia e os arquivos.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="how" class="how">
    <div class="wrap">
      <div class="how-head">
        <div class="section-head">
          <p class="eyebrow">Como funciona</p>
          <h2>Configure uma vez. Daí em diante, todos os apps lembram.</h2>
        </div>
        <Download small />

      </div>
      <ol class="steps">
        <li class="step">
          <div class="step-text">
            <span class="step-no">01</span>
            <h3>Instale e entre</h3>
            <p>Baixe o app para Windows ou Mac e crie uma conta ou entre por ele. Seu
               teste grátis de {TRIAL.days} dias começa na primeira vez que você entra pelo app do
               Zaaheen, e não precisa de cartão. Sua conta nunca guarda suas memórias.
               <a href={L('/docs/getting-started/')}>Guia de instalação e configuração</a></p>
          </div>
          <div class="snippet">
            <div class="snippet-title">Create your Zaaheen account, or sign in.</div>
            <div class="snippet-pills"><span class="pill-dark">Create an account</span><span class="pill-dark">Sign in</span></div>
          </div>
        </li>
        <li class="step">
          <div class="step-text">
            <span class="step-no">02</span>
            <h3>Conecte seus apps de IA</h3>
            <p>Conecte o {apps} pelo app, uma única vez. Outros apps compatíveis com MCP devem
               funcionar do mesmo jeito.</p>
          </div>
          <div class="snippet snippet-list">
            {PICTURED_APPS.map((a, i) => (
              <div class={i < 2 ? 'srow' : 'srow is-off'}>
                <span class="srow-name"><span class="chip-dot"></span>{a}</span>
                <span class="mono-note">{i < 2 ? 'connected' : '+ connect'}</span>
              </div>
            ))}
          </div>
        </li>
        <li class="step">
          <div class="step-text">
            <span class="step-no">03</span>
            <h3>Seus apps de IA conectados lembram</h3>
            <p>O que você conta a um app, os outros podem lembrar. Cada memória aparece no
               app, onde você pode pesquisá-la ou esquecê-la.</p>
          </div>
          <div class="snippet snippet-mems">
            {MEMORIES.map((m) => (
              <div class="mrow is-card">
                <span class="mrow-ty">{m.type}</span>
                <span class="mrow-tx">{m.text}</span>
              </div>
            ))}
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section id="faq" class="faq">
    <div class="wrap">
      <div class="section-head is-centred">
        <p class="eyebrow">Perguntas frequentes</p>
        <h2>O que as pessoas perguntam sobre o Zaaheen.</h2>
      </div>
      <div class="faq-list">
        {FAQ.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}{f.link && <> <a href={f.link.href}>{f.link.text}</a>.</>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script src="../../scripts/hero.js"></script>
</Base>
