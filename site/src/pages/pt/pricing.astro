---
// The Pricing page in Brazilian Portuguese (ADR-113): the English page's
// structure with its words translated. The comparison and the FAQ come from
// src/data/pricing.ts in English, so their words are translated here; the
// facts, prices and sources are the same.
import Base from '../../layouts/Base.astro';
import { PRICES, RELEASE, TRIAL, VERIFIED_APPS, pageFor, verifiedAppList } from '../../data/site';
import { CHECKED_ON, COMPARISON_SOURCES } from '../../data/pricing';
import { localize } from '../../i18n/locales';
import { formatDate } from '../../i18n/ui';

const page = pageFor('/pt/pricing/');
const L = (href: string) => localize(href, 'pt');
const saving = PRICES.monthly * 12 - PRICES.yearly;
const appsThen = VERIFIED_APPS.join(', ');
const apps = verifiedAppList().replace(/ and /, ' e ');
const checkedOn = formatDate(CHECKED_ON, 'pt');
const INCLUDED = [
  'Quantas memórias você quiser, guardadas e criptografadas no seu próprio computador',
  'Todos os apps de IA que você conectar: Claude, ChatGPT, Cursor e outros',
  'Arrumação no seu computador, diária ou semanal, quando você escolher',
  'Download my memories a qualquer momento, mesmo depois que você parar de pagar',
  'Apague tudo em um só passo, para sempre',
  'Ajuda por e-mail das pessoas que criam o app',
];

const COMPARISON = [
  {
    name: 'Zaaheen',
    kind: 'Memória para todos os seus apps de IA',
    price: `US$ ${PRICES.monthly} por mês ou US$ ${PRICES.yearly} por ano. ${TRIAL.days} dias grátis, sem cartão`,
    where: 'Seu computador',
    encrypted: 'Sim, no seu computador. Nossos servidores nunca recebem suas memórias',
    training: 'Não',
    apps: `Sim: ${appsThen} e outros apps compatíveis com MCP`,
  },
  {
    name: 'MemoryPlugin',
    kind: 'Plano Core',
    price: 'US$ 15 por mês ou US$ 89 por ano',
    where: 'Servidores deles',
    encrypted: 'Sim, em trânsito e armazenadas, sem ponta a ponta',
    training: 'Não',
    apps: 'Sim: "21+ AI tools"',
  },
  {
    name: 'Pieces',
    kind: 'Plano Pro',
    price: 'US$ 18,99 por mês',
    where: 'Seu computador',
    encrypted: 'Não informado',
    training: 'Não',
    apps: 'Sim: "every MCP-ready AI tool"',
  },
  {
    name: 'Mem',
    kind: 'App de notas com IA, plano Plus',
    price: 'US$ 9 por mês (há um plano grátis)',
    where: 'Servidores deles',
    encrypted: 'Sim, armazenadas e em trânsito, sem ponta a ponta',
    training: 'Não',
    apps: 'Sim, pelo conector do próprio Mem',
  },
  {
    name: 'Obsidian',
    kind: 'App de notas',
    price: 'App grátis. Sync por US$ 5 por mês ou US$ 48 por ano',
    where: 'Seu computador. O Sync copia as notas para os servidores deles',
    encrypted: 'Sync: sim, de ponta a ponta',
    training: 'Não informado',
    apps: 'Só por plugins feitos pela comunidade',
  },
  {
    name: 'Memória do ChatGPT',
    kind: 'Integrada ao ChatGPT',
    price: 'Incluída; o plano grátis tem "limited memory"',
    where: 'Servidores deles',
    encrypted: 'Sim, armazenadas e em trânsito',
    training: 'Sim, a menos que você desative',
    apps: 'Integrada ao ChatGPT',
  },
  {
    name: 'Memória do Claude',
    kind: 'Integrada ao Claude',
    price: 'Incluída, até no plano grátis',
    where: 'Servidores deles',
    encrypted: 'Sim, armazenadas e em trânsito',
    training: 'Só se você permitir',
    apps: 'Integrada ao Claude',
  },
];

// The sources' names, in Portuguese where they are descriptions.
const SOURCE_NAMES: Record<string, string> = {
  'ChatGPT memory': 'Memória do ChatGPT',
  'Claude pricing': 'Preços do Claude',
  'Claude training policy': 'Política de treinamento do Claude',
};

const COMPARE_PAGES = [
  { path: '/learn/ai-memory-apps-compared/', label: 'Apps de memória para IA comparados' },
  { path: '/learn/chatgpt-memory-vs-claude-memory/', label: 'Memória do ChatGPT x memória do Claude' },
  { path: '/learn/mem0-alternative/', label: 'Mem0' },
  { path: '/learn/supermemory-alternative/', label: 'Supermemory' },
  { path: '/learn/memoryplugin-alternative/', label: 'MemoryPlugin' },
  { path: '/learn/best-memory-mcp-server-for-claude-code/', label: 'Servidores de memória para o Claude Code' },
  { path: '/learn/obsidian-vs-ai-memory-app/', label: 'Obsidian' },
];

const PRICING_FAQ: { q: string; a: string; link?: { href: string; text: string } }[] = [
  {
    q: 'O que é o Zaaheen?',
    a: `O Zaaheen é uma memória privada para seus apps de IA. Ele roda no seu PC com Windows ou no seu Mac e dá ao ${appsThen} e a outros apps de IA uma única memória compartilhada sobre você, para você parar de se repetir. Suas memórias ficam no seu próprio computador, criptografadas.`,
  },
  {
    q: 'Quanto custa o Zaaheen?',
    a: `O Zaaheen custa US$ ${PRICES.monthly} por mês ou US$ ${PRICES.yearly} por ano, mais IVA ou imposto sobre vendas quando se aplicar. Os dois planos incluem tudo. Você começa com um teste grátis de ${TRIAL.days} dias.`,
  },
  {
    q: 'Preciso de cartão para o teste grátis do Zaaheen?',
    a: `Não. O teste de ${TRIAL.days} dias do Zaaheen não pede cartão, então nada é cobrado quando ele termina. O Zaaheen simplesmente pede que você assine.`,
  },
  {
    q: 'O ChatGPT e o Claude já têm memória. Por que eu precisaria do Zaaheen?',
    a: 'A memória interna de cada app pertence àquele app. O que o ChatGPT aprende sobre você fica com o ChatGPT, e o que o Claude aprende fica com o Claude. O Zaaheen é uma única memória que todos os seus apps de IA conectados compartilham: salve algo no Claude, e o Cursor ou o ChatGPT também podem usar. Você pode continuar usando a memória de cada app junto com ele.',
  },
  {
    q: 'O ChatGPT e o Claude podem compartilhar a mesma memória?',
    a: 'Sim, com o Zaaheen. Conecte os dois apps ao Zaaheen e eles vão ler e salvar na mesma memória do seu computador.',
    link: { href: L('/learn/share-memory-between-chatgpt-and-claude/'), text: 'Como compartilhar memória entre o ChatGPT e o Claude' },
  },
  {
    q: 'Qual é a diferença entre o Zaaheen e o MemoryPlugin, o Pieces, o Mem ou o Supermemory?',
    a: `O Zaaheen guarda suas memórias no seu próprio computador, criptografadas, e nossos servidores nunca as recebem. O MemoryPlugin e o Mem guardam as suas nos servidores deles. O Pieces também guarda as memórias no seu computador; o plano Pro dele custa US$ 18,99 por mês e o teste pede cartão. O Zaaheen custa menos que o MemoryPlugin Core ou o Pieces Pro, e o teste dele não pede cartão. O plano pago do Supermemory é voltado a desenvolvedores que criam com memória de IA, por isso ele não está na tabela. A tabela acima traz os detalhes dos outros, conferidos no site de cada empresa em ${checkedOn}.`,
    link: { href: L('/learn/ai-memory-apps-compared/'), text: 'Apps de memória para IA comparados' },
  },
  {
    q: 'O Zaaheen é parecido com o Obsidian?',
    a: 'O Obsidian é um app de notas: você mesmo escreve e organiza as notas, e os apps de IA só chegam a elas por plugins feitos pela comunidade. O Zaaheen é feito para os seus apps de IA: eles salvam o que aprendem sobre você e encontram isso de novo sozinhos, em todos os apps que você conectar. Os dois guardam seus dados no seu próprio computador.',
  },
  {
    q: 'O Zaaheen usa minhas memórias para treinar IA?',
    a: 'Não. O Zaaheen nunca recebe suas memórias, então não pode usá-las para treinar nada. Os apps de IA que você conecta têm as próprias configurações de treinamento, que você controla em cada app.',
  },
  {
    q: 'A equipe do Zaaheen pode ler minhas memórias?',
    a: 'Não. Suas memórias são guardadas e criptografadas no seu próprio computador, e a chave também fica lá. O Zaaheen nunca as envia para a internet, então não temos nenhuma cópia para ler. Os apps de IA que você conecta podem enviar memórias a quem os criou como parte das suas conversas, de acordo com as políticas de privacidade desses apps.',
  },
  {
    q: 'Quais apps de IA funcionam com o Zaaheen?',
    a: `Testamos o Zaaheen com ${apps}. Ele também funciona com outros apps de IA compatíveis com MCP, a forma padrão de os apps de IA se conectarem a ferramentas. O app do Zaaheen mostra como conectar cada um.`,
  },
  {
    q: 'Meus apps de IA vão usar mesmo o Zaaheen?',
    a: 'Alguns apps, como o Cursor, consultam o Zaaheen sozinhos quando você pergunta algo sobre você. Outros, como o Claude e o ChatGPT, costumam olhar primeiro na própria memória, então o app do Zaaheen dá a você uma dica de uma linha para eles que faz com que consultem o Zaaheen também.',
  },
  {
    q: 'Posso trazer minhas memórias atuais do ChatGPT ou do Claude para o Zaaheen?',
    a: 'Ainda não há importação com um clique. Depois que um app estiver conectado, você pode pedir que ele salve no Zaaheen o que importa, e todos os outros apps conectados poderão usar isso.',
    link: { href: L('/learn/switch-from-chatgpt-to-claude/'), text: 'Como trocar o ChatGPT pelo Claude sem começar do zero' },
  },
  {
    q: 'O Zaaheen funciona no Mac ou no celular?',
    a: 'No Mac, sim: o Zaaheen funciona em Macs com chip da Apple (M1 ou mais recente), testado no macOS 26. Ele também roda no Windows, testado no Windows 11. Ainda não há app para celular.',
  },
  {
    q: 'Posso cancelar o Zaaheen a qualquer momento?',
    a: 'Sim. Cancele no app em Settings, depois Account, depois Cancel subscription, e você mantém o acesso até o fim do período que já pagou. Se você pedir em até 14 dias após um pagamento, nós o reembolsamos integralmente, uma vez por pessoa.',
  },
  {
    q: 'O que acontece com minhas memórias se eu parar de pagar o Zaaheen?',
    a: 'Nada é apagado. Suas memórias ficam no seu computador, e Download my memories continua funcionando, então você sempre pode levá-las com você. O Zaaheen deixa de atender seus apps de IA até você assinar de novo.',
  },
  {
    q: 'Por que não manter um arquivo de texto com anotações para a minha IA?',
    a: 'Um arquivo de anotações funciona bem para um app e um projeto, e um arquivo como o AGENTS.md é o lugar certo para as regras de um projeto. O Zaaheen é para o que é verdade sobre você: seus apps de IA salvam o que aprendem sobre você pelo caminho, encontram a memória certa quando ela importa e a compartilham com todos os apps que você conectar.',
    link: { href: L('/learn/ai-memory-tool-or-notes-file/'), text: 'Uma ferramenta de memória ou um arquivo de anotações?' },
  },
];
---
<Base page={page}>
  <div class="pricing">
    <header class="pricing-head">
      <p class="eyebrow">Comece com {TRIAL.days} dias grátis, sem precisar de cartão</p>
      <h1>Preços do Zaaheen: um plano, tudo incluído.</h1>
      <p class="lede">O Zaaheen dá a todos os seus apps de IA uma única memória privada, guardada no seu próprio computador.
         Experimente grátis por {TRIAL.days} dias e depois escolha como prefere pagar.</p>
    </header>

    <div class="plans">
      <section class="plan" aria-labelledby="plan-monthly">
        <h2 id="plan-monthly">Mensal</h2>
        <p class="plan-price"><span class="plan-amount">US$ {PRICES.monthly}</span> por mês</p>
        <p class="plan-tax">Mais IVA ou imposto sobre vendas quando se aplicar.</p>
        <p class="plan-note">Renova todo mês até você cancelar.</p>
        {RELEASE.available
          ? <a class="cta" href={L('/docs/subscribe/')}>Como assinar</a>
          : <span class="cta cta-soon">Em breve para Windows e Mac</span>}
      </section>
      <section class="plan plan-best" aria-labelledby="plan-yearly">
        <p class="plan-tag">Economize US$ {saving} por ano</p>
        <h2 id="plan-yearly">Anual</h2>
        <p class="plan-price"><span class="plan-amount">US$ {PRICES.yearly}</span> por ano</p>
        <p class="plan-tax">Mais IVA ou imposto sobre vendas quando se aplicar.</p>
        <p class="plan-note">Renova todo ano até você cancelar.</p>
        {RELEASE.available
          ? <a class="cta" href={L('/docs/subscribe/')}>Como assinar</a>
          : <span class="cta cta-soon">Em breve para Windows e Mac</span>}
      </section>
    </div>

    <section class="pricing-included" aria-labelledby="included">
      <h2 id="included">O que está incluído nos dois planos</h2>
      <ul>
        {INCLUDED.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="pricing-compare" aria-labelledby="compare">
      <h2 id="compare">Como o Zaaheen se compara</h2>
      <p class="pricing-compare-lede">Outros produtos de memória para IA, e a memória integrada aos próprios
         apps de IA, comparados no que importa na hora de escolher.</p>
      <div class="vs-wrap">
        <table class="vs">
          <thead>
            <tr>
              <th scope="col">Produto</th>
              <th scope="col">Preço para uma pessoa</th>
              <th scope="col">Onde suas memórias ficam</th>
              <th scope="col">Criptografado</th>
              <th scope="col">Usado para treinar IA</th>
              <th scope="col">Funciona em todos os seus apps de IA</th>
            </tr>
          </thead>
          <tbody>
            {COMPARISON.map((c, i) => (
              <tr class={i === 0 ? 'vs-us' : undefined}>
                <th scope="row">{c.name} <span class="vs-plan">{c.kind}</span></th>
                <td>{c.price}</td>
                <td class="vs-where">{c.where}</td>
                <td>{c.encrypted}</td>
                <td>{c.training}</td>
                <td>{c.apps}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="vs-note">Os preços e recursos das outras empresas foram tirados dos próprios sites
         e páginas de privacidade delas em {checkedOn}, em dólares americanos antes de impostos, com as palavras
         delas entre aspas. "Não informado" quer dizer que as páginas da própria empresa não dizem. Os preços e
         as políticas delas podem mudar, então confira antes de comprar:
         {COMPARISON_SOURCES.map((src, i) => (
           <>{i > 0 && ', '}<a href={src.url} target="_blank" rel="noopener noreferrer">{SOURCE_NAMES[src.name] ?? src.name}</a></>
         ))}.</p>
      <p class="vs-note">Comparações detalhadas:
         {COMPARE_PAGES.map((c, i) => (
           <>{i > 0 && ' · '}<a href={L(c.path)}>{c.label}</a></>
         ))}.</p>
    </section>

    <section class="pricing-small" aria-labelledby="small-print">
      <h2 id="small-print">As letras miúdas, em palavras simples</h2>
      <ul>
        <li>Seu teste de {TRIAL.days} dias não pede cartão, então nada é cobrado quando ele termina. O Zaaheen
            simplesmente pede que você assine.</li>
        <li>Os preços são em dólares americanos, mais IVA ou imposto sobre vendas quando se aplicar, cobrados pela
            nossa revendedora Paddle. Você vê o total exato antes de pagar.</li>
        <li>Seu plano renova automaticamente até você cancelar. Cancele quando quiser no app, na página
            <em>Account</em> do site, ou com o link de cancelamento de qualquer e-mail da Paddle, e
            mantenha o acesso até o fim do período que você já pagou.</li>
        <li>Peça em até 14 dias após um pagamento e nós o reembolsamos integralmente, uma vez por pessoa. Veja a <a
            href="/refunds/">Política de Reembolso (em inglês)</a> e os <a href="/terms/">Termos de Serviço (em inglês)</a>.</li>
        <li>Os pagamentos são processados pela Paddle.com, nossa revendedora e Merchant of Record.</li>
      </ul>
    </section>

    <section class="pricing-faq" aria-labelledby="pricing-faq">
      <h2 id="pricing-faq">Perguntas sobre o Zaaheen</h2>
      <div class="faq-list">
        {PRICING_FAQ.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}{f.link && <> <a href={f.link.href}>{f.link.text}</a>.</>}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>
