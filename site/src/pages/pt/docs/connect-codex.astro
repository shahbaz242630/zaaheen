---
// The Codex connect guide in Brazilian Portuguese (ADR-113). The steps come from
// the desktop app's own wording, translated in src/i18n/ui/pt.ts.
import Guide from '../../../layouts/Guide.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'Codex';
const OUTLINE = connectOutline(NAME).map((o) => ({ ...o, title: t('pt', o.title) }));
---
<Guide
  path="/pt/docs/connect-codex/"
  lede="Adicione a configuração do Zaaheen ao config.toml do Codex (a aba Agents do Zaaheen mostra essa configuração para o seu computador), reinicie o Codex e confira se /mcp mostra o zaaheen como conectado. Já conectou o ChatGPT Desktop? O Codex compartilha as configurações dele, então basta conferir se está conectado."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Codex › config.toml" />
  </section>
</Guide>
