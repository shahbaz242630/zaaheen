---
// The Cursor Desktop connect guide in Brazilian Portuguese (ADR-113). The steps come from
// the desktop app's own wording, translated in src/i18n/ui/pt.ts.
import Guide from '../../../layouts/Guide.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'Cursor Desktop';
const OUTLINE = connectOutline(NAME).map((o) => ({ ...o, title: t('pt', o.title) }));
---
<Guide
  path="/pt/docs/connect-cursor/"
  lede="No Zaaheen, abra a aba Agents, escolha Connect an app, depois Cursor Desktop e Connect it for me. O Cursor abre e pede para você instalar o Zaaheen, o que pode levar até um minuto: clique em Install. O Cursor IDE passa a usar a mesma conexão."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Cursor › Customize" />
  </section>
</Guide>
