---
// The ChatGPT Desktop connect guide in Brazilian Portuguese (ADR-113). The steps come from
// the desktop app's own wording, translated in src/i18n/ui/pt.ts.
import Guide from '../../../layouts/Guide.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'ChatGPT Desktop';
const OUTLINE = connectOutline(NAME).map((o) => ({ ...o, title: t('pt', o.title) }));
---
<Guide
  path="/pt/docs/connect-chatgpt/"
  lede="No ChatGPT Desktop, abra Settings, depois Plugins, depois MCP, e adicione um servidor MCP chamado Zaaheen com o comando da aba Agents do Zaaheen e os argumentos mcp e serve. Depois use o Zaaheen em um chat de Work ou de Codex."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="ChatGPT › Settings" />
  </section>
</Guide>
