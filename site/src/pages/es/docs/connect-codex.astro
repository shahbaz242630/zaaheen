---
// Codex guide in Spanish (ADR-113): the English guide's structure; the steps come
// from the app's own wording through ConnectSteps, translated in src/i18n/ui/es.ts.
import Guide from '../../../layouts/Guide.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'Codex';
const OUTLINE = connectOutline(NAME).map((s) => ({ ...s, title: t('es', s.title) }));
---
<Guide
  path="/es/docs/connect-codex/"
  lede="Añade la configuración de Zaaheen al config.toml de Codex (la pestaña Agents de Zaaheen la muestra para tu computadora), reinicia Codex y comprueba que /mcp muestra zaaheen como conectado. ¿Ya conectaste ChatGPT Desktop? Codex comparte su configuración, así que solo comprueba que está conectado."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Codex › config.toml" />
  </section>
</Guide>
