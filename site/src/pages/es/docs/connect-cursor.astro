---
// Cursor Desktop guide in Spanish (ADR-113): the English guide's structure; the steps come
// from the app's own wording through ConnectSteps, translated in src/i18n/ui/es.ts.
import Guide from '../../../layouts/Guide.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'Cursor Desktop';
const OUTLINE = connectOutline(NAME).map((s) => ({ ...s, title: t('es', s.title) }));
---
<Guide
  path="/es/docs/connect-cursor/"
  lede="En Zaaheen, abre la pestaña Agents, elige + Connect an AI app, luego Cursor Desktop y Connect it for me. Cursor se abre y te pide que instales Zaaheen, lo que puede tardar hasta un minuto: haz clic en Install. Después, el Cursor IDE usa la misma conexión."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Cursor › Customize" />
  </section>
</Guide>
