---
// Antigravity guide in Spanish (ADR-113): the English guide's structure; the steps come
// from the app's own wording through ConnectSteps, translated in src/i18n/ui/es.ts.
import Guide from '../../../layouts/Guide.astro';
import ConnectSteps from '../../../components/ConnectSteps.astro';
import { connectOutline } from '../../../data/app-words';
import { t } from '../../../i18n/ui';

const NAME = 'Antigravity';
const OUTLINE = connectOutline(NAME).map((s) => ({ ...s, title: t('es', s.title) }));
---
<Guide
  path="/es/docs/connect-antigravity/"
  lede="Abre el archivo de configuración de Antigravity, mcp_config.json, pega la configuración de Zaaheen de la pestaña Agents de Zaaheen, guarda y reinicia Antigravity. Después comprueba que Zaaheen aparece con un círculo verde en sus herramientas MCP."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Antigravity › mcp_config.json" />
  </section>
</Guide>
