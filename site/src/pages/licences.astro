---
import Policy, { type Outline } from '../layouts/Policy.astro';
import Row from '../components/Row.astro';
import { COMPANY, SITE } from '../data/site';

// Open-source licences (founder, session 69, option 1: "yes option 1 partner").
// The licences of the open-source code and AI models Zaaheen uses (MIT, Apache
// 2.0 and similar) require their notices to ship with the app; the full list
// ships with the app, generated at build time (LEGAL-DOCUMENTS-DESIGN L7). This
// page names no component: the white-label rule keeps the stack off public
// pages, and the licences are met by the notices that ship with the app.
const OUTLINE: Outline[] = [
  { id: 'licences', title: 'Open-source licences', topics: [
    { id: 'what', title: 'What Zaaheen uses' },
    { id: 'notices', title: 'Where to find the notices' },
  ] },
];
const topic = (id: string) =>
  OUTLINE.flatMap((s) => s.topics).find((t) => t.id === id)?.title ?? id;
const mail = `mailto:${COMPANY.email}`;
const lede = `${SITE.name} is built with the help of open-source software and AI models made by others. This page explains how we honour their licences.`;
---
<Policy path="/licences/" heading="Open-source licences" lede={lede} outline={OUTLINE}>
  <ul slot="summary">
    <li>Zaaheen includes open-source software and AI models made by others.</li>
    <li>They are used under their own licences, such as the MIT and Apache 2.0 licences.</li>
    <li>The full notices ship with the app, and we send a copy to anyone who asks.</li>
  </ul>

  <section id="licences" class="docs-section">
    <h2 class="docs-title">Open-source licences</h2>

    <Row id="what" title={topic('what')} where="Open source">
      <p>Zaaheen includes open-source software and AI models made by other people and companies.
         Each is used under its own licence, such as the MIT and Apache 2.0 licences, and those
         licences, not our <a href="/terms/">Terms of Service</a>, govern those parts. We are
         grateful to everyone who makes them.</p>
    </Row>

    <Row id="notices" title={topic('notices')} where="With the app">
      <p>The full notices, with each licence's text and its authors' copyright lines, ship with
         the Zaaheen app in the folder where it is installed. You can also email <a
         href={mail}>{COMPANY.email}</a> and we will send you a copy.</p>
    </Row>
  </section>
</Policy>
