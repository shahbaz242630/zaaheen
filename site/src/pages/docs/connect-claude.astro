---
import Guide from '../../layouts/Guide.astro';
import ConnectSteps from '../../components/ConnectSteps.astro';
import { connectOutline } from '../../data/app-words';

// Claude Desktop, built from the app's own wording (data/app-words.ts reads
// crates/vault-tauri/dist/app.js), so this page says what the Agents tab says.
const NAME = 'Claude Desktop';
---
<Guide
  path="/docs/connect-claude/"
  lede="In Zaaheen, open the Agents tab, choose + Connect an AI app, then Claude Desktop and Save the extension, and install it in Claude. Then add one line to Claude's instructions so it uses Zaaheen. It works in Claude's Chat and Cowork."
  outline={connectOutline(NAME)}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Claude › Settings" />
  </section>
</Guide>
