---
import Guide from '../../layouts/Guide.astro';
import ConnectSteps from '../../components/ConnectSteps.astro';
import { connectOutline } from '../../data/app-words';

// ChatGPT Desktop, built from the app's own wording (data/app-words.ts reads
// crates/vault-tauri/dist/app.js). ChatGPT has no install route, so it is
// added by hand, one box at a time.
const NAME = 'ChatGPT Desktop';
---
<Guide
  path="/docs/connect-chatgpt/"
  lede="In ChatGPT Desktop, open Settings, then Plugins, then MCP, and add an MCP server named Zaaheen with the command from Zaaheen's Agents tab and the arguments mcp and serve. Then use Zaaheen in a Work or Codex chat."
  outline={connectOutline(NAME)}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="ChatGPT › Settings" />
  </section>
</Guide>
