---
import Guide from '../../layouts/Guide.astro';
import Row from '../../components/Row.astro';
import ConnectSteps from '../../components/ConnectSteps.astro';
import { connectOutline } from '../../data/app-words';

// Claude Code, built from the app's own wording (data/app-words.ts reads
// crates/vault-tauri/dist/app.js).
const NAME = 'Claude Code';
const OUTLINE = [...connectOutline(NAME), { id: 'using', title: 'Using it' }];
---
<Guide
  path="/docs/connect-claude-code/"
  lede="In a terminal, run one command from Zaaheen's Agents tab. Zaaheen is then available in every Claude Code project."
  outline={OUTLINE}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Terminal" />

    <Row level={2} id="using" title="Using it" where="Claude Code">
      <p>Ask Claude Code about yourself, your preferences or your work, or ask it to check your
         Zaaheen memory. What it saves there, your other connected AI apps can use too.</p>
    </Row>
  </section>
</Guide>
