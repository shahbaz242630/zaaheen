---
import Guide from '../../layouts/Guide.astro';
import Row from '../../components/Row.astro';
import ConnectSteps from '../../components/ConnectSteps.astro';
import { connectOutline } from '../../data/app-words';
import { verifiedAppList } from '../../data/site';

// Codex, Antigravity and any other MCP app, each built from the app's own
// wording (data/app-words.ts reads crates/vault-tauri/dist/app.js). Row ids
// are prefixed per app so one page holds all three.
const APPS = [
  { name: 'Codex', prefix: 'codex-', where: 'Codex › config.toml' },
  { name: 'Antigravity', prefix: 'antigravity-', where: 'Antigravity › mcp_config.json' },
  { name: 'Another app', prefix: 'other-', where: 'Your app' },
];
const OUTLINE = [
  { id: 'what', title: 'What your app needs' },
  ...APPS.flatMap((a) => [{ id: `${a.prefix}app`, title: a.name }, ...connectOutline(a.name, a.prefix)]),
];
---
<Guide
  path="/docs/connect-other-apps/"
  lede="Zaaheen connects to AI apps over MCP, the standard way AI apps connect to tools. Codex, Antigravity and other apps take the setting from Zaaheen's Agents tab, which shows it for your computer exactly."
  outline={OUTLINE}
>
  <section class="docs-section">
    <Row level={2} id="what" title="What your app needs" where="MCP">
      <p>Your AI app needs to support MCP servers that run on your computer. We have tested Zaaheen
         with {verifiedAppList()}, and each has its own guide. Other apps that support MCP should
         work the same way.</p>
    </Row>

    {APPS.map((a) => (
      <>
        <Row level={2} id={`${a.prefix}app`} title={a.name} where={a.where}>
          <p>The steps for {a.name === 'Another app' ? 'any other app' : a.name}, as Zaaheen's Agents tab gives them.</p>
        </Row>
        <ConnectSteps name={a.name} where={a.where} prefix={a.prefix} />
      </>
    ))}
  </section>
</Guide>
