---
import Guide from '../../layouts/Guide.astro';
import Row from '../../components/Row.astro';
import ConnectSteps from '../../components/ConnectSteps.astro';
import { connectOutline } from '../../data/app-words';
import { GUIDES } from '../../data/site';

// Any other AI app that supports MCP, built from the app's own wording
// ("Another app" in data/app-words.ts). Every app we have tested has its own
// guide (session 83, founder: Codex and Antigravity each on their own page),
// listed here so nobody follows the general steps by mistake.
const NAME = 'Another app';
const APP_GUIDES = GUIDES.filter((g) => g.path.startsWith('/docs/connect-') && g.path !== '/docs/connect-other-apps/');
const OUTLINE = [{ id: 'what', title: 'What your app needs' }, ...connectOutline(NAME)];
---
<Guide
  path="/docs/connect-other-apps/"
  lede="Zaaheen connects to AI apps over MCP, the standard way AI apps connect to tools. If your app has its own guide below, use that. Otherwise give your app the setting from Zaaheen's Agents tab, which shows it for your computer exactly."
  outline={OUTLINE}
>
  <section class="docs-section">
    <Row level={2} id="what" title="What your app needs" where="MCP">
      <p>Your AI app needs to support MCP servers that run on your computer. Using {APP_GUIDES.map((g, i) => (
           <>{i > 0 && (i === APP_GUIDES.length - 1 ? ' or ' : ', ')}<a href={g.path}>{g.label.replace(/^Connect /, '')}</a></>
         ))}? Use its own guide instead. For any other app, follow the steps below.</p>
    </Row>
    <ConnectSteps name={NAME} where="Your app" />
  </section>
</Guide>
