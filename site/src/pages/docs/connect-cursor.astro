---
import Guide from '../../layouts/Guide.astro';
import ConnectSteps from '../../components/ConnectSteps.astro';
import { connectOutline } from '../../data/app-words';

// Cursor Desktop (and through it the Cursor IDE), built from the app's own
// wording (data/app-words.ts reads crates/vault-tauri/dist/app.js).
const NAME = 'Cursor Desktop';
---
<Guide
  path="/docs/connect-cursor/"
  lede="In Zaaheen, open the Agents tab, choose + Connect an AI app, then Cursor Desktop and Connect it for me. Cursor opens and asks you to install Zaaheen, which can take up to a minute: click Install. The Cursor IDE then uses the same connection."
  outline={connectOutline(NAME)}
>
  <section class="docs-section">
    <ConnectSteps name={NAME} where="Cursor › Customize" />
  </section>
</Guide>
