---
import { COACHING_POLICIES, DOCS_SECTIONS, GUIDES, POLICIES } from '../data/site';
import { englishPath, langOf, localize } from '../i18n/locales';
import { t } from '../i18n/ui';

// The Documents menu on the left (founder, session 67): dropdowns for "Using
// Zaaheen" (the how-to sections of /docs/), "Guides" (one task per page,
// session 71) and "Policies" (each policy on its own page). The group holding the page you're on starts open. Plain
// <details>, so it opens and closes with no script. On a coaching document
// (founder, session 70: coaching is "a completely separate thing") it lists
// coaching's own documents only.
interface Props {
  /** '/docs/', a guide's path or a policy's path. */
  current: string;
  coaching?: boolean;
}
const { current, coaching = false } = Astro.props;
// On a translated page (ADR-113 D2): labels in its language, links to the same
// language where the page is translated, "(English)" on the ones that stay
// English. The search covers the English documents only, so it is left out.
const lang = langOf(current);
const here = englishPath(current);
const L = (href: string) => localize(href, lang);
const label = (path: string, english: string) =>
  lang === 'en' ? english : L(path) === path ? `${t(lang, english)} (${t(lang, 'English')})` : t(lang, english);
const onDocs = here === '/docs/';
const onGuide = GUIDES.some((g) => g.path === here);
---
{coaching ? (
  <nav class="docs-sections" aria-label="Coaching documents">
    <details class="docs-group" open>
      <summary>Coaching policies</summary>
      {COACHING_POLICIES.filter((p) => p.live).map((p) => (
        <a href={p.path} aria-current={p.path === current ? 'page' : undefined}>{p.label}</a>
      ))}
    </details>
    <a href="/knowledge-centre/">Back to the Knowledge Centre</a>
  </nav>
) : (
  <nav class="docs-sections" aria-label={t(lang, 'Documents')}>
    <!-- s83: search every guide, policy and error fix. Hidden until
         scripts/search.js runs; it searches in the browser, sends nothing. -->
    {lang === 'en' && (
      <form class="docs-search" role="search" data-search hidden>
        <input type="search" name="q" placeholder="Search the documents" aria-label="Search the documents" autocomplete="off" />
        <ul class="docs-search-results" aria-live="polite" hidden></ul>
      </form>
    )}
    <details class="docs-group" open={onDocs}>
      <summary>{t(lang, 'Using Zaaheen')}</summary>
      {DOCS_SECTIONS.map((s) => (
        <a href={onDocs ? `#${s.id}` : `${L('/docs/')}#${s.id}`} data-section={onDocs ? s.id : undefined}>{t(lang, s.title)}</a>
      ))}
    </details>
    <details class="docs-group" open={onGuide}>
      <summary>{t(lang, 'Guides')}</summary>
      {GUIDES.map((g) => (
        <a href={L(g.path)} aria-current={g.path === here ? 'page' : undefined}>{label(g.path, g.label)}</a>
      ))}
    </details>
    <details class="docs-group" open={!onDocs && !onGuide}>
      <summary>{t(lang, 'Policies')}</summary>
      {POLICIES.map((p) => (
        <a href={p.path} aria-current={p.path === current ? 'page' : undefined}>{label(p.path, p.label)}</a>
      ))}
    </details>
  </nav>
)}
{!coaching && lang === 'en' && <script src="../scripts/search.js"></script>}
