---
// One connect guide's steps, built from the desktop app's own wording
// (data/app-words.ts reads it from crates/vault-tauri/dist/app.js), so a guide
// always says what the app says (session 82). Steps are numbered as the app
// numbers them; a Windows | Mac switch shows the visitor's own computer first
// (scripts/platform.js); the Agents tab's exact setting comes first, the usual
// install path only as a fallback.
import Row from './Row.astro';
import CopyBox from './CopyBox.astro';
import { appWords, appAgent, openerText, stepTitles } from '../data/app-words';
import { INSTALL_PATH, MAC_INSTALL_PATH } from '../data/site';
import { langOf } from '../i18n/locales';
import { t, tHtml } from '../i18n/ui';

interface Props {
  /** The app's name exactly as the app's Agents tab shows it. */
  name: string;
  /** Where the app's own settings live, for the rows' small tag. */
  where: string;
  /** Row ids' prefix, when one page holds several apps (connectOutline uses the same). */
  prefix?: string;
}
const { name, where, prefix = '' } = Astro.props;
// On a translated guide (ADR-113 D2) every sentence is in the page's language,
// the app's own help text included (keyed by its English, so a wording change
// in the app fails the build until it is translated again). Labels the reader
// clicks stay in English, as the app shows them.
const lang = langOf(Astro.url.pathname);
const tr = (english: string | undefined) => (english === undefined ? undefined : t(lang, english));
const titles = stepTitles(name);
const agent = appAgent(name);
const macAgent = appAgent(name, true);
const words = appWords();
const quick = agent.connect ? words.CONNECT_WORDS[agent.connect] : null;
const check = words.AGENT_CHECKS[name];
const tip = words.AGENT_TIPS[name];
const os = [
  { key: 'win', label: 'Windows', agent, command: INSTALL_PATH },
  { key: 'mac', label: 'Mac', agent: macAgent, command: MAC_INSTALL_PATH },
];
const group = `os-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
{agent.note && <p class="connect-note">{tr(agent.note)}</p>}
{titles.note && <p class="connect-steps-note"><strong>{tr(titles.note)}</strong></p>}

{quick && (
  <Row level={2} id={`${prefix}quick`} title={tr(titles.quick)!} where="Zaaheen › Agents">
    <p>{tr(quick.note)}</p>
    <ol>
      <li set:html={tHtml(lang, 'In Zaaheen, open the <em>Agents</em> tab and choose <em>+ Connect an AI app</em>.')} />
      <li set:html={tHtml(lang, 'Choose <em>{name}</em>, then <em>{button}</em>.', { name, button: quick.button })} />
      {quick.waiting && <li>{tr(quick.waiting)}</li>}
      <li>{tr(quick.saved ?? quick.asked)}</li>
    </ol>
    {quick.saved && <p set:html={tHtml(lang, "If {app} opens and asks you to install Zaaheen instead, click <em>Install</em>, and it's connected.", { app: name.split(' ')[0] })} />}
  </Row>
)}

<Row level={2} id={`${prefix}by-hand`} title={tr(titles.byHand)!} where={where}>
  <p set:html={tHtml(lang, "The easiest way to get the setting right: in Zaaheen, open <em>Agents</em>, choose <em>+ Connect an AI app</em>, then <em>{name}</em>. It shows the setting with this computer's own path, with a Copy button. Use the Copy buttons rather than selecting text by hand.", { name })} />
  <div class="os-switch" data-os-switch>
    <input class="os-radio os-radio-win" type="radio" name={group} id={`${group}-win`} checked />
    <label class="os-tab" for={`${group}-win`}>Windows</label>
    <input class="os-radio os-radio-mac" type="radio" name={group} id={`${group}-mac`} data-os-mac />
    <label class="os-tab" for={`${group}-mac`}>Mac</label>
    {os.map((o) => (
      <div class={`os-pane os-pane-${o.key}`}>
        {/* s83, founder: the boxes below hold the USUAL install path; say so
            before anyone copies it, since their own path may differ. */}
        {(o.agent.snippet || (o.agent.openers ?? []).some((x) => typeof x.command === 'function')) && (
          <p class="path-note" set:html={o.key === 'win'
            ? tHtml(lang, '<strong>The path below is an example.</strong> It will look like <code>{path}</code>, which is where Zaaheen usually installs on Windows. If you installed Zaaheen somewhere else, such as another drive or folder, your path is different, and this one will not work. Copy your exact path from Zaaheen: <em>Agents</em>, <em>+ Connect an AI app</em>, <em>{name}</em>, then <em>Copy</em>.', { path: o.command, name })
            : tHtml(lang, '<strong>The path below is an example.</strong> It will look like <code>{path}</code>, which is where Zaaheen usually installs on a Mac. If you installed Zaaheen somewhere else, your path is different, and this one will not work. Copy your exact path from Zaaheen: <em>Agents</em>, <em>+ Connect an AI app</em>, <em>{name}</em>, then <em>Copy</em>.', { path: o.command, name })} />
        )}
        <p>{tr(o.agent.hint)}</p>
        {(o.agent.openers ?? []).map((opener) => (
          <>
            <p>{tr(opener.label)}</p>
            <CopyBox text={openerText(opener, o.command)} />
          </>
        ))}
        {o.agent.pasteHint && <p>{tr(o.agent.pasteHint)}</p>}
        {o.agent.snippet && <CopyBox text={o.agent.snippet(o.command)} />}
      </div>
    ))}
  </div>
</Row>

{check && (
  <Row level={2} id={`${prefix}check`} title={tr(titles.check)!} where={where}>
    <p>{tr(check)}</p>
  </Row>
)}

{tip && (
  <Row level={2} id={`${prefix}tip`} title={tr(titles.tip)!} where={where}>
    <p>{tr(tip)}</p>
    <CopyBox text={words.TIP_LINE} />
  </Row>
)}
<script src="../scripts/platform.js"></script>
