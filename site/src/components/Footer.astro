---
import Logo from './Logo.astro';
import { COACHING, COACHING_POLICIES, COMPANY, SITE } from '../data/site';
import { langOf, localize } from '../i18n/locales';
import { formatDate, t } from '../i18n/ui';

// The footer on every page (founder, session 67: "a little bit professional
// footer", after the Best Answer Hub one): the brand, three columns of links,
// then the company line. Two variants (founder, session 70: the Knowledge
// Centre is "a completely separate thing"):
// - "app" on every page but the Knowledge Centre's: every app policy stays
//   linked here (scripts/audit.mjs POLICIES).
// - "coaching" on the Knowledge Centre's pages: coaching's own documents
//   (COACHING_POLICIES, the live ones) and no app policy
//   (scripts/audit.mjs COACHING_POLICIES and APP_ONLY).
//
// "Page last updated" (founder, s94: dates in the footer help with Google): the
// page's own date from lib/lastmod, which moves only when that page's words
// change. The footer is outside <main>, so it never feeds the date fingerprint.
interface Props {
  variant?: 'app' | 'coaching';
  /** The page's lastModified date (ISO 8601); no line when the page has none. */
  updated?: string;
}
const { variant = 'app', updated } = Astro.props;
// A translated page's footer is in its language (ADR-113 D2); links go to the
// same language where that page is translated. The legal pages stay English,
// so on a translated page their labels say so.
const lang = langOf(Astro.url.pathname);
const L = (href: string) => localize(href, lang);
const english = (label: string) => (lang === 'en' ? label : `${t(lang, label)} (${t(lang, 'English')})`);
const updatedLabel = updated ? formatDate(updated, lang) : undefined;
const coaching = variant === 'coaching';
const year = new Date().getFullYear();

const APP_COLUMNS = [
  { title: t(lang, 'Product'), links: [
    { label: t(lang, 'The memory app'), href: L('/products/') },
    { label: t(lang, 'Pricing'), href: L('/pricing/') },
    { label: t(lang, 'Documents'), href: L('/docs/') },
    { label: t(lang, 'Learn'), href: L('/learn/') },
    { label: english('AI and your data'), href: '/ai-and-your-data/' },
  ] },
  { title: t(lang, 'Company'), links: [
    { label: english('Company information'), href: '/company/' },
    { label: english('Knowledge Centre'), href: '/knowledge-centre/' },
    { label: english('Security'), href: '/security/' },
    { label: t(lang, 'Contact us'), href: L('/docs/contact/') },
  ] },
  { title: t(lang, 'Legal'), links: [
    { label: english('Terms of Service'), href: '/terms/' },
    { label: english('Privacy Policy'), href: '/privacy/' },
    { label: english('Refund Policy'), href: '/refunds/' },
    { label: english('Open-source licences'), href: '/licences/' },
  ] },
];

const COACHING_COLUMNS = [
  { title: 'Coaching', links: [
    ...(COACHING.bookingOpen ? [{ label: 'Book a session', href: COACHING.bookingUrl }] : []),
    { label: 'Sessions', href: '/knowledge-centre/#sessions' },
    { label: 'Contact us', href: '/knowledge-centre/contact/' },
    ...(COACHING.bookingOpen ? [{ label: 'Withdraw from contract here', href: COACHING.withdrawUrl }] : []),
  ] },
  { title: 'Zaaheen', links: [
    { label: 'Home', href: '/' },
    { label: 'Products', href: '/products/' },
    { label: 'Company information', href: '/company/' },
  ] },
  { title: 'Coaching policies', links: COACHING_POLICIES
    .filter((p) => p.live)
    .map((p) => ({ label: p.label, href: p.path })) },
].filter((c) => c.links.length > 0);

const columns = coaching ? COACHING_COLUMNS : APP_COLUMNS;
const blurb = coaching
  ? 'Private 1-to-1 AI coaching, built around a real task you bring. Booked and paid online, delivered live.'
  : t(lang, 'A private memory for your AI apps. Your memories stay encrypted on your own computer and never reach us.');
const email = coaching ? COACHING.email : COMPANY.email;
---
<footer class:list={['site-foot', { 'is-coaching': coaching }]} data-footer={variant}>
  <div class="foot-inner">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="foot-logo" href={L('/')} aria-label={t(lang, '{name} home', { name: SITE.name })}>
          <Logo size={48} />
          <span>{coaching ? `${SITE.name} Knowledge Centre` : SITE.name}</span>
        </a>
        <p>{blurb}</p>
      </div>
      {columns.map((c) => (
        <nav class="foot-col" aria-label={c.title}>
          <p class="foot-title">{c.title}</p>
          {c.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>
    <div class="foot-bottom">
      <p>© {year} {COMPANY.legalName}. {t(lang, 'All rights reserved.')}</p>
      {updated && <p data-page-updated>{t(lang, 'Page last updated')} <time datetime={updated}>{updatedLabel}</time></p>}
      <p>{COMPANY.licence} · <a href={`mailto:${email}`}>{email}</a></p>
    </div>
  </div>
</footer>
