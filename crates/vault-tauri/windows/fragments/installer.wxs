<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Zaaheen MSI installer fragment — T0.2.14 packaging.

  Referenced from tauri.conf.json:
    bundle.windows.wix.fragmentPaths = ["./windows/fragments/installer.wxs"]
    bundle.windows.wix.componentRefs = [
      "SetLanceMemPoolEnv", "VaultCliBinary", "VaultMaintenanceBinary",
      "AddInstallDirToPath"
    ]

  Processed only at `tauri build` (candle/light) time — never at `cargo build`,
  so it has zero effect on CI (which compiles + tests but does not bundle).

  ✅ VERIFIED at first bundle (2026-07-23):
    - Install dir id IS "INSTALLDIR" — confirmed against the generated
      target/release/wix/x64/main.wxs (the app's own files install there).
    - File @Source uses an ABSOLUTE path to the built zaaheen.exe. candle
      resolves relative @Source against its own working dir (not the .wxs
      location), which is not something we control here — absolute removes the
      ambiguity. LOCAL-BUILD ASSUMPTION: the repo lives at the path below; a
      portable/CI bundle would templatize this. Acceptable for the local beta
      build (the MSI must be built locally anyway — CI ships 0-byte fixtures).
    - Components that install a file MUST sit under <DirectoryRef Id="..."> and
      MUST NOT also carry a Component/@Directory attribute (that combination is
      WiX error CNDL0062). Directory context comes from the enclosing ref.

  Chose a WiX File component over bundle.externalBin deliberately: externalBin
  is compile-time validated (would need per-triple CI placeholders) AND derives
  a WiX Component @Id from the binary name — and a hyphen ("zaaheen-maintenance")
  is an illegal WiX identifier (candle CNDL0014; tauri #14681). Here we set every
  @Id ourselves, so the natural filenames ship unchanged.
  ============================================================================
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>

    <!-- Environment/registry components are directory-agnostic; keep them under TARGETDIR. -->
    <DirectoryRef Id="TARGETDIR">

      <!--
        ADR-038 — LANCE_MEM_POOL_SIZE (256 MiB) in the installed user's
        environment so lance/datafusion's merge_insert JOIN path is bounded on
        every launch of BOTH the desktop app AND zaaheen.exe (the MCP server
        an AI client spawns opens the same lance store and needs the same
        bound). Cannot be set in Rust: ADR-002 forbids unsafe_code and
        std::env::set_var is unsafe. Per-user (no elevation), removed on
        uninstall. The HKCU RegistryValue is the component KeyPath (an
        Environment element cannot itself be a KeyPath under WiX v3 ICE rules).
      -->
      <Component Id="SetLanceMemPoolEnv" Guid="7E9C1F2A-4B6D-4E3F-9A1C-2D5E8F0B3C7A">
        <RegistryValue
          Root="HKCU"
          Key="Software\com.zaaheen.app\Install"
          Name="LanceEnvKeyPath"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <Environment
          Id="LanceMemPoolSize"
          Name="LANCE_MEM_POOL_SIZE"
          Value="268435456"
          Action="set"
          Part="all"
          System="no"
          Permanent="no" />
      </Component>

      <!--
        Put the app install dir on the user's PATH so the UNCHANGED, cross-agent
        proven snippet `command = "zaaheen"` resolves. Keeping the bare name
        (vs an absolute backslash path in the JSON/TOML snippet) is the more
        portable choice across MCP clients. Part="last" appends; per-user; the
        entry is removed on uninstall. Users are already told to restart their
        agent after adding the config, which is also when the new PATH is seen.
        Value="[INSTALLDIR]" references the install-dir PROPERTY, so this
        component's own directory does not matter — hence TARGETDIR.
      -->
      <Component Id="AddInstallDirToPath" Guid="9B7D5F3A-2E4C-4B6D-8A1F-3C5E7A9B1D3F">
        <RegistryValue
          Root="HKCU"
          Key="Software\com.zaaheen.app\Install"
          Name="PathKeyPath"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <Environment
          Id="AddVaultToPath"
          Name="PATH"
          Value="[INSTALLDIR]"
          Action="set"
          Part="last"
          System="no"
          Permanent="no" />
      </Component>

    </DirectoryRef>

    <!--
      Ship zaaheen.exe INTO the app directory so MCP works in an installed
      build (blocker (c)). Without it, onboarding's `zaaheen mcp serve`
      snippet is a promise nothing keeps and no AI client can connect.
      Consolidation is intentionally out of scope for this beta (Phi-4 not
      wired) — this binary's job here is MCP only. Sits beside zaaheen-desktop.exe
      via the INSTALLDIR directory ref (NO Component/@Directory — CNDL0062).
    -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="VaultCliBinary" Guid="2C4A6E8B-1D3F-4A5C-9E7B-0F2A4C6E8B1D">
        <File
          Id="VaultCliExe"
          Name="zaaheen.exe"
          Source="C:\Projects\GitHub\Memory Vault\target\release\zaaheen.exe"
          KeyPath="yes" />
      </Component>

      <!--
        ADR-SEC-015 — the windowless maintenance runner.

        MUST ship beside zaaheen.exe. The runner resolves its child as its
        own SIBLING (`current_exe().parent()`), so installing one without the
        other gives a scheduled task that starts, finds nothing to run, and
        records a failed maintenance run every night.

        This is the binary the registered OS task points at. `zaaheen.exe` is
        a console program, so scheduling it directly opened a black terminal on
        the user's desktop at login — observed on the founder's machine
        2026-08-27. This one is linked for the Windows subsystem and spawns
        zaaheen.exe with CREATE_NO_WINDOW, so nothing is ever displayed.

        Same @Id-by-hand reasoning as VaultCliBinary above: the hyphen in
        "zaaheen-maintenance" is an illegal WiX identifier, so we name the
        component ourselves and the natural filename ships unchanged.
      -->
      <Component Id="VaultMaintenanceBinary" Guid="5F1B3D7C-8A2E-4C6B-9D4F-1E3A5C7B9D2F">
        <File
          Id="VaultMaintenanceExe"
          Name="zaaheen-maintenance.exe"
          Source="C:\Projects\GitHub\Memory Vault\target\release\zaaheen-maintenance.exe"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!--
      ========================================================================
      ADR-SEC-005 close (2026-07-28) — uninstall removes the registered
      maintenance task.

      THE GAP THIS CLOSES, observed live rather than reasoned about: on the
      founder's machine `\com.memoryvault.maintenance` (the pre-Zaaheen task
      id) was still registered from a session-27 test, still `Ready`, still
      firing DAILY, pointing at a `target\debug\vault-cli.exe` inside the repo
      (the pre-rename binary name), and returning Last Result 1
      every morning. Turning the feature on once leaves an OS-level task that
      outlives whatever created it. For a product whose promise is "you own
      your data and nothing is left behind", leaving a scheduled job on a
      machine after uninstall is squarely the wrong behaviour.

      WHY schtasks.exe AND NOT OUR OWN CLI: during an uninstall our
      binary is the thing being deleted. Driving removal through it would mean
      sequencing before RemoveFiles, and it could be file-locked, missing, or
      crash — and a crash here fails the USER'S UNINSTALL. schtasks.exe ships
      with Windows, is always present, and is unaffected by our own removal.
      (vault-scheduler's tested `unregister` still owns removal at RUN time;
      this is purely the teardown path, where that crate is unavailable.)

      WHY `NOT UPGRADINGPRODUCTCODE` — the non-obvious one. `REMOVE="ALL"` is
      ALSO true while a major upgrade removes the OLD product. Conditioned on
      REMOVE alone, every app update would silently switch off the user's
      automatic maintenance and never say so. UPGRADINGPRODUCTCODE is set only
      in that removal-during-upgrade pass, so excluding it keeps the schedule
      across upgrades and clears it only on a real uninstall.

      Return="ignore": `schtasks /Delete` exits non-zero when the task is
      absent (never scheduled, or already removed). That must NEVER fail an
      uninstall — matching the idempotent posture `Scheduler::unregister`
      already has in Rust.

      Execute="immediate" (not deferred): the task is per-user, created by the
      interactive user with LogonType=InteractiveToken (verified session 27),
      so removal belongs in that same user's context. Immediate execution also
      resolves [SystemFolder] normally, which a deferred action cannot.
      KNOWN LIMIT, accepted: if user A installs and user B uninstalls, A's task
      survives. Deferred-as-SYSTEM would cover that but cannot resolve
      properties and would delete another user's task from an unelevated UI
      flow. Single-owner desktop vault — not worth the complexity today.

      The task id is DUPLICATED from `MAINTENANCE_TASK_ID` in
      `src/commands/maintenance.rs`. That cross-language duplication is pinned
      by `tests/installer_contract.rs`, the same guard pattern
      `frontend_contract.rs` uses for the JS↔Rust boundary.

      ⚠️ MUST stay in THIS <Fragment>. A WiX fragment is pulled in only when
      something references it; tauri.conf.json's componentRefs reference the
      three components above. A CustomAction placed in a separate fragment
      would be silently dropped from the MSI with no error.

      Scope: Windows only. macOS/Linux ship no installer yet, so there is no
      uninstall hook to attach to. Their teardown lands with their packaging.
      ========================================================================
    -->
    <CustomAction
      Id="RemoveMaintenanceTask"
      Directory="INSTALLDIR"
      ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /Delete /TN &quot;com.zaaheen.maintenance&quot; /F"
      Execute="immediate"
      Return="ignore" />

    <!--
      ADR-102 — uninstall also removes the vault keeper's on-demand task.

      The keeper (the one process that owns the vault while AI apps are
      connected) is started through a per-user Task Scheduler entry that the
      first `zaaheen mcp serve` registers. It is named per user,
      com.zaaheen.keeper.<SID>, so two Windows users on one PC never share or
      overwrite one. Windows Installer's standard UserSID property is the SID of
      the user running this uninstall, which is the entry this user's relays
      registered.

      Same reasoning as RemoveMaintenanceTask above for every attribute:
      schtasks.exe rather than our own CLI, immediate execution in the user's
      context, Return="ignore" because an absent task must never fail an
      uninstall, NOT UPGRADINGPRODUCTCODE so an update keeps it, and this same
      Fragment so it cannot be orphaned. The prefix is pinned to
      vault_app::keeper::KEEPER_TASK_ID_PREFIX by installer_contract.rs.
    -->
    <CustomAction
      Id="RemoveKeeperTask"
      Directory="INSTALLDIR"
      ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /Delete /TN &quot;com.zaaheen.keeper.[UserSID]&quot; /F"
      Execute="immediate"
      Return="ignore" />

    <!--
      ADR-102 honest limit 4 (session 35) — stop Zaaheen's BACKGROUND copies
      before Windows Installer checks for files in use.

      Every AI app that uses Zaaheen runs its own zaaheen.exe (a relay), and one
      more zaaheen.exe (the keeper) owns the vault while any of them is
      connected; zaaheen-maintenance.exe waits on the keeper. None has a window,
      so Windows Installer cannot ask them to close: an update found
      zaaheen.exe in use and could not replace it without a restart, which is
      why users were told to quit every AI app first.

      Ending them here is safe for the vault: a relay owns nothing, and a keeper
      that is ended looks to the stores exactly like one that crashed, which
      they are built to survive (durable queue, WAL, atomic commits). The AI apps
      see their Zaaheen connection close and reconnect to the new version when
      restarted. The desktop app is NOT ended: it has a window, so Windows
      Installer asks the user to close it the ordinary way.

      Unconditional (install, update, repair and uninstall all replace or remove
      these files). Before InstallValidate, which is where the in-use check
      runs. TARGETDIR as the working directory because INSTALLDIR does not exist
      yet on a first install. Return="ignore": taskkill exits non-zero when
      nothing is running, which is the common case and must never fail setup.
    -->
    <CustomAction
      Id="StopZaaheenBackground"
      Directory="TARGETDIR"
      ExeCommand="&quot;[SystemFolder]taskkill.exe&quot; /F /IM zaaheen.exe /IM zaaheen-maintenance.exe"
      Execute="immediate"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopZaaheenBackground" Before="InstallValidate" />
      <Custom Action="RemoveMaintenanceTask" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RemoveKeeperTask" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

  </Fragment>
</Wix>
